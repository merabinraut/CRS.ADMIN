@model CRS.ADMIN.APPLICATION.Models.ConversionMetrixManagement.ConversionMetrixOverviewModel
@{
    ViewBag.Title = "Conversion Metrix";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<div class="px-8 py-4 flex flex-col gap-8">
    @Html.AntiForgeryToken()
    <!-- Header -->
    <div class="flex justify-between items-center">
        <div>
            <div class="heading-title">@CRS.ADMIN.APPLICATION.Resources.Resource.ConversionMetrixManagement</div>
        </div>
        <button id="allStoresBtn" class="btn btn-secondary font-normal" value="" type="button">
            @(string.IsNullOrWhiteSpace(ViewBag.clubId)
    ? CRS.ADMIN.APPLICATION.Resources.Resource.All_Stores
    : ViewBag.clubName)
            <div class="ml-2">
                <svg width="9" height="6" viewBox="0 0 9 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.33008 6L-5.01156e-05 8.15666e-07L8.6602 5.85621e-08L4.33008 6Z" fill="#7B7B7B" />
                </svg>
            </div>
        </button>
    </div>

    <div>
        @Html.HiddenFor(model => model.TabValue)
        <input type="hidden" name="TabValue" id="TabValue" value="@ViewBag.TabValue" />
        <div class="flex gap-[24px]" style="border-bottom:1px solid #f4f4f4;">
            <div class="flex tab-container-plane bg-white gap-[16px]">

                <button id="tab1Button"
                        type="button"
                        class="tab-button-plane tab-link active">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Overview
                </button>

                <button id="tab2Button" class="tab-button-plane tab-link">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Active_Log
                </button>

            </div>
        </div>
    </div>
    <div id="tab1Content" class="pane active">
        @Html.Partial("_OverviewTab", Model)
    </div>

    <!-- Tab 2 -->
    <div id="tab2Content" style="display:none;" class="pane">
        @Html.Partial("manage_activities_conversionMetrix", Model)
    </div>

</div>
@Html.Partial("GetStoreDetailsList", Model)

