@model CRS.ADMIN.APPLICATION.Models.ConversionMetrixManagement.ConversionMetrixOverviewModel

<div id="add-new-store"
     class="flex justify-end fixed top-0 right-0 z-40 h-screen w-full bg-black/40 transition-transform translate-x-full"
     tabindex="-1"
     aria-labelledby="drawer-right-label">

    <div class="bg-white w-[616px] h-full flex flex-col relative shadow-xl overflow-hidden">
        <!-- Header -->
        <div class="sticky top-0 z-[10] flex justify-between items-center
                    bg-secondary-color-pink py-[16px] px-[24px] h-[56px] shrink-0">
            <span class="text-white font-medium">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Select_Store
            </span>
            <button type="button" id="CloseId"
                    data-drawer-hide="add-new-store"
                    aria-controls="add-new-store"
                    class="text-white text-[20px] leading-none">
                <i class="las la-window-close"></i>
            </button>
        </div>
        <!-- Body -->
        <div class="flex-1 overflow-y-auto p-4 bg-white">
            <div class="flex items-center gap-4">
                <div class="relative flex-1">
                    <i class="las la-search absolute left-3 top-1/2 -translate-y-1/2
               text-gray-400 text-[18px]"></i>
                    <input id="storeSearch" type="text"
                           placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search_Club"
                           class="w-full border border-gray-200 rounded-lg py-2 pl-9 pr-3
                  text-sm focus:outline-none focus:ring-2 focus:ring-pink-400" />
                </div>
                <!-- Area Filter -->
                <div class="flex items-center gap-2 min-w-[180px]">
                    <label class="text-sm text-gray-500 whitespace-nowrap">
                        @CRS.ADMIN.APPLICATION.Resources.Resource.Area
                    </label>
                    <select id="storeAreaFilter"
                            class="flex-1 border border-gray-200 rounded-lg px-3 py-2
               text-sm focus:outline-none focus:ring-2 focus:ring-pink-400">
                        <option value="">@CRS.ADMIN.APPLICATION.Resources.Resource.All</option>
                        @if (ViewBag.LocationList != null)
                        {
                            foreach (var location in ViewBag.LocationList as IEnumerable<SelectListItem>)
                            {
                                <option value="@location.Value">@location.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="mt-4">
                <div class="flex border border-gray-200 rounded-lg overflow-hidden w-[240px]">
                    <button type="button" data-topn="10"
                            class="topn-btn flex py-2 px-4 text-sm font-medium
                bg-secondary-color-pink text-white hover:bg-gray-50">
                        Top 10
                    </button>
                    <button type="button" data-topn="50"
                            class="topn-btn flex py-2 px-4 text-sm text-gray-500
                border-l border-gray-200 hover:bg-gray-50">
                        Top 50
                    </button>
                    <button type="button" data-topn="100"
                            class="topn-btn flex py-2 px-4 text-sm text-gray-500
                border-l border-gray-200 hover:bg-gray-50">
                        Top 100
                    </button>
                </div>
            </div>
            <div class="mt-4 ml-2">
                <h2 class="text-xs text-gray-400 uppercase tracking-wide mb-3">
                    <span id="rankedClubTitle">Top 10</span>
                </h2>
                <div id="storeClubList" class="flex flex-col divide-y divide-gray-100"></div>
            </div>
        </div>
    </div>
</div>
