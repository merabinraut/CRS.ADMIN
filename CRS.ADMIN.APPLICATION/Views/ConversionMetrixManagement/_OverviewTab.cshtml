<script>
    (function () {
        var PINK = '#C2185B';
        var PURPLE = '#7F77DD';
        var AREA_COLORS = [
            '#C2185B', '#7F77DD', '#1D9E75',
            '#F89336', '#378ADD', '#E24B4A', '#639922'
        ];
        var chartInstance = null;

        function escHtml(s) {
            return $('<div>').text(String(s || '')).html();
        }

        function getQueryParam(name) {
            const match = window.location.search.match(
                new RegExp("[?&]" + name + "=([^&]+)")
            );

            return match ? decodeURIComponent(match[1]) : null;
        }

        // Single combined call: today's click chart + action source + click origin
        function loadClickAnalytics(filter) {
           
            console.log("Received filter:", filter);
            console.trace("loadClickAnalytics called");
            var normalizedFilter = (filter || 'all').toLowerCase().trim();
            var tzOffset = -new Date().getTimezoneOffset();

            console.log("normalizedFilter =", normalizedFilter);

            $('#actionSourceList').html('<p class="text-[13px] text-gray-400 py-2">Loading...</p>');
            $('#clickOriginList').html('<p class="text-[13px] text-gray-400 py-2">Loading...</p>');

            const clubId = getQueryParam("clubId");
            $.ajax({
                url: '/ConversionMetrixManagement/GetClickAnalytics',
                type: 'GET',
                cache: false,
                data: {
                    clubId: clubId,
                    channel: normalizedFilter,
                    timezoneOffset: tzOffset
                },
                success: function (response) {
                    if (!response || response.success === false) {
                        console.error('[ClickAnalytics] server error:', response && response.message);
                        showEmpty();
                        renderActionSource([]);
                        renderClickOrigin([]);
                        return;
                    }
                    renderChart(response.chartData, filter);
                    renderActionSource(response.actionSource);
                    renderClickOrigin(response.clickOrigin);
                },
                error: function (err) {
                    console.error('[ClickAnalytics] AJAX error:', err);
                    showEmpty();
                    renderActionSource([]);
                    renderClickOrigin([]);
                }
            });
        }

        window.reloadOverviewSummary = function () {
            $.ajax({
                url: '/ConversionMetrixManagement/GetConversionSummaryJson',
                type: 'GET',
                cache: false,
                data: { clubId: window.selectedClubId },
                success: function (response) {
                    if (!response || response.success === false) {
                        console.error('[Summary] server error:', response && response.message);
                        return;
                    }
                    $('#totalClicksValue').text(response.totalClicks);
                    $('#reservationClicksValue').text(response.reservationClicks);
                    $('#phoneCallClicksValue').text(response.phoneCallClicks);
                    $('#averageCtrValue').text(parseFloat(response.averageCTR).toFixed(1) + ' %');
                },
                error: function () {
                    console.error('[Summary] AJAX error');
                }
            });

            loadClickAnalytics($('#clickChartFilter').val() || 'all');
        };

        function renderChart(res, filter) {
            var labels = (res && res.labels) ? res.labels : [];
            var datasets = buildDatasets(res, filter);

            if (!labels.length || !datasets.length) {
                showEmpty();
                return;
            }

            document.getElementById('clickChartWrap').style.display = 'block';
            var emptyEl = document.getElementById('clickChartEmpty');
            emptyEl.classList.add('hidden');
            emptyEl.classList.remove('flex');
            emptyEl.style.display = '';
            document.getElementById('clickChartLegend').style.display = 'flex';

            if (chartInstance) {
                chartInstance.destroy();
            }

            chartInstance = new Chart(document.getElementById('Month12'), {
                type: 'bar',
                data: { labels: labels, datasets: datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + ctx.dataset.label + ': '
                                        + Math.round(ctx.parsed.y) + ' Click';
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(0,0,0,0.06)', lineWidth: 0.5 },
                            border: { color: 'rgba(0,0,0,0.06)' },
                            ticks: {
                                color: '#111827',
                                font: { size: 12 },
                                autoSkip: true,
                                maxTicksLimit: 24,
                                maxRotation: 0,
                                padding: 6
                            },
                            title: {
                                display: true,
                                color: '#111827',
                                font: { size: 12 },
                                padding: { top: 8 }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.06)', lineWidth: 0.5 },
                            border: { dash: [3, 3], color: 'transparent' },
                            ticks: {
                                color: '#111827',
                                font: { size: 12 },
                                stepSize: 5,
                                padding: 8,
                                callback: function (v) { return Math.round(v); }
                            },
                            title: {
                                display: true,
                                color: '#111827',
                                font: { size: 12 },
                                padding: { bottom: 8 }
                            }
                        }
                    },
                    interaction: { mode: 'index', intersect: false }
                }
            });

            renderLegend(datasets);
        }

        function buildDatasets(res, filter) {
            if (!res || !res.datasets) return [];
            var colorMap = { all: PINK, reservation: PINK, phone: PURPLE };
            var labelMap = {
                all: '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Total_Clicks))',
                reservation: '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Reservation_Clicks))',
                phone: '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Phone_Call_Click))'
            };

            var items = res.datasets;

            return items.map(function (d) {
                var c = colorMap[d.type] || PINK;
                return {
                    label: labelMap[d.type] || d.type,
                    data: d.data,
                    backgroundColor: c + '26',
                    borderColor: c,
                    borderWidth: 1.5,
                    borderRadius: 4,
                    borderSkipped: false,
                    barPercentage: 0.6,
                    categoryPercentage: 0.7
                };
            });
        }

        function showEmpty() {
            document.getElementById('clickChartWrap').style.display = 'none';
            var emptyEl = document.getElementById('clickChartEmpty');
            emptyEl.classList.remove('hidden');
            emptyEl.classList.add('flex');
            emptyEl.style.display = 'flex';
            document.getElementById('clickChartLegend').style.display = 'none';
            if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
        }

        // Fixed: reads color directly off each dataset instead of re-deriving
        // it from label text (which never matched anything before).
        function renderLegend(datasets) {
            
            var totalClicksLabel = '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Total_Clicks))';
            var html = datasets
                .filter(function (ds) {
                    //return ds.label !== totalClicksLabel;
                })
                .map(function (ds) {
                return '<span style="display:flex;align-items:center;gap:6px;font-size:12px;color:#6b7280;">'
                    + '<span style="width:10px;height:10px;border-radius:2px;background:' + ds.borderColor + '"></span>'
                        + ds.label
                        + '</span>';
                })
                .join('');

            document.getElementById('clickChartLegend').innerHTML = html;
        }

        var STR_STORE_PAGE = '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Store_Page))';
        var STR_HOST_DETAIL_PAGE = '@Html.Raw(HttpUtility.JavaScriptStringEncode(CRS.ADMIN.APPLICATION.Resources.Resource.Host_Detail_Page))';

// 2. Map the hardcoded categories to their localized versions
         var ACTION_SOURCE_MAPPING = {
            'store page': STR_STORE_PAGE || '店舗ページ',
            'host detail page': STR_HOST_DETAIL_PAGE || 'ホスト詳細ページ'
         };

        var ACTION_SOURCE_CATEGORIES = ['Store Page', 'Host Detail Page'];

        function renderActionSource(data) {
            var byLabel = {};
            (data || []).forEach(function (d) {
                if (d.label) {
                    byLabel[d.label.toLowerCase().trim()] = d;
                }
            });

            var html = ACTION_SOURCE_CATEGORIES.map(function (label) {
                var key = label.toLowerCase().trim();
                var d = byLabel[key];
                var pct = d && d.percentage ? parseFloat(d.percentage).toFixed(1) : '0.0';
                var displayLabel = ACTION_SOURCE_MAPPING[key] || label;
                return '<div class="mb-4">'
                    + '<div class="mb-2 flex justify-between text-[#18181B] text-[13px]">'
                    + '<span>' + escHtml(displayLabel) + '</span>'
                    + '<span>' + pct + '%</span>'
                    + '</div>'
                    + '<div class="w-full bg-[#F4F4F5] rounded-full h-[5px]">'
                    + '<div class="bg-primary-100 h-[5px] rounded-full" style="width:' + pct + '%"></div>'
                    + '</div>'
                    + '</div>';
            }).join('');

            $('#actionSourceList').html(html);
        }


        var CLICK_ORIGIN_AREAS = ['Tokyo', 'Osaka', 'Aichi'];

        function renderClickOrigin(data) {
            if (!data || !data.length) {
                $('#clickOriginList').html(
                    '<p class="text-[13px] text-gray-400 py-2">No data available.</p>'
                );
                return;
            }

            var max = Math.max.apply(null, data.map(function (d) { return d.clicks || 0; }).concat([1]));

            var html = data.map(function (d, i) {
                var pct = d.percentage ? parseFloat(d.percentage).toFixed(1) : '0.0';
                var barPct = max > 0 ? Math.round(((d.clicks || 0) / max) * 100) : 0;
                var color = AREA_COLORS[i % AREA_COLORS.length];

                return '<div class="flex items-center gap-[10px] py-[9px]'
                    + ' border-b border-[#F4F4F5] last:border-b-0">'
                    + '<span style="width:10px;height:10px;border-radius:50%;'
                    + 'background:' + color + ';flex-shrink:0;display:inline-block;"></span>'
                    + '<span class="flex-1 text-[13px] text-[#18181B]">' + escHtml(d.area) + '</span>'
                    + '<div style="width:80px;background:#F4F4F5;border-radius:999px;height:4px;">'
                    + '<div style="width:' + barPct + '%;height:4px;border-radius:999px;'
                    + 'background:' + color + ';"></div>'
                    + '</div>'
                    + '<span class="text-[13px] font-semibold text-[#18181B]'
                    + ' min-w-[38px] text-right">' + pct + '%</span>'
                    + '</div>';
            }).join('');

            $('#clickOriginList').html(html);
        }


        $(document).on('select2:select', '#clickChartFilter', function () {
            var value = $(this).val();
            console.log("Select2 changed:", value);
            loadClickAnalytics(value);
        });

        $(document).ready(function () {

            $(document).on('change', '#clickChartFilter', function () {
                var value = $(this).val();

                console.log("Dropdown changed:", value);

                loadClickAnalytics(value);
            });



            loadClickAnalytics("all");
        });
    })();
</script>
