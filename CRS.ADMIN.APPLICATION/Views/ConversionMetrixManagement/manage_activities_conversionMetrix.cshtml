@model CRS.ADMIN.APPLICATION.Models.ConversionMetrixManagement.ConversionMetrixOverviewModel

<div class="flex justify-between pb-[24px]">
    <form action="/ConversionMetrixManagement/Index"
          method="get"
          class="flex justify-between items-center w-full" id="filterFormActivity">

        <!-- Left Side -->
        <div class="relative input-search-wrapper">
            <div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                    <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                          stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <input type="search"
                   id="default-search-activity"
                   class="input-search block w-full"
                   placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search_By_StoreName"
                   value="@ViewBag.SearchFilter"
                   name="SearchFilter">
        </div>

        <!-- Right Side -->
        <input type="hidden" id="clubId" name="clubId" value="@ViewBag.ClubId" />
        <input type="hidden" id="searchFilter" name="SearchFilter" value="@ViewBag.SearchFilter" />
        <input type="hidden" id="searchFilter2" name="SearchFilter2" value="@ViewBag.SearchFilter2" />
        <input type="hidden" id="startIndex" name="StartIndex" value="@ViewBag.StartIndex" />
        <input type="hidden" id="pageSize" name="PageSize" value="@ViewBag.PageSize" />
        <input type="hidden" id="startIndex2" name="StartIndex2" value="@ViewBag.StartIndex2" />
        <input type="hidden" id="pageSize2" name="PageSize2" value="@ViewBag.PageSize2" />
        <input type="hidden" id="TabValue" name="TabValue" value="@ViewBag.TabValue" />
        <input type="hidden" id="FromDateMs" name="FromDateMs" />
        <input type="hidden" id="ToDateMs" name="ToDateMs" />


        <div class="flex items-center gap-6 ml-auto">
            <button type="button"
                    id="activityLogThisMonthBtn"
                    class="h-[40px] flex items-center gap-[8px] px-[12px] border border-[#D4D4D8] rounded-[5px] text-[14px] text-gray-500 font-medium">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5.625 2.5V3.125H3.125V16.875H16.875V3.125H14.375V2.5H13.125V3.125H6.875V2.5H5.625ZM4.375 4.375H5.625V5H6.875V4.375H13.125V5H14.375V4.375H15.625V5.625H4.375V4.375ZM4.375 6.875H15.625V15.625H4.375V6.875ZM8.125 8.125V9.375H9.375V8.125H8.125ZM10.625 8.125V9.375H11.875V8.125H10.625ZM13.125 8.125V9.375H14.375V8.125H13.125ZM5.625 10.625V11.875H6.875V10.625H5.625ZM8.125 10.625V11.875H9.375V10.625H8.125ZM10.625 10.625V11.875H11.875V10.625H10.625ZM13.125 10.625V11.875H14.375V10.625H13.125ZM5.625 13.125V14.375H14.375V13.125H5.625Z"
                          fill="#A1A1AA" fill-opacity="0.75" />
                </svg>
                @CRS.ADMIN.APPLICATION.Resources.Resource.This_Month
            </button>

            <div class="export-button h-[40px]" onclick="exportExcel('table-id', 'Club')">
                <img src="~/Content/assets_new/images/club/download-solid.svg">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Export_CSV
            </div>
        </div>

    </form>
</div>

<div class="border border-[#D0D5DD] rounded-[5px] p-[20px]">

    <div class="mb-4 flex w-max text-[#3E3E3E] text-sm font-semibold">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 10H15M2.5 5H17.5M7.5 15H12.5" stroke="#3E3E3E" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="ml-2">
            @CRS.ADMIN.APPLICATION.Resources.Resource.Filter_By
        </div>

    </div>
    <form id="filterForm2" method="get" action="@Url.Action("Index", "ConversionMetrixManagement")">

        <input type="hidden" id="ClubId" name="clubId" value="@ViewBag.ClubId" />
        <input type="hidden" id="SearchFilter" name="SearchFilter" value="@ViewBag.SearchFilter" />
        <input type="hidden" id="SearchFilter2" name="SearchFilter2" value="@ViewBag.SearchFilter2" />
        <input type="hidden" id="StartIndex" name="StartIndex" value="@ViewBag.StartIndex" />
        <input type="hidden" id="PageSize" name="PageSize" value="@ViewBag.PageSize" />
        <input type="hidden" id="StartIndex2" name="StartIndex2" value="@ViewBag.StartIndex2" />
        <input type="hidden" id="PageSize2" name="PageSize2" value="@ViewBag.PageSize2" />
        <input type="hidden" id="TabValue" name="TabValue" value="@ViewBag.TabValue" />
        <input type="hidden" id="FromDateMs" name="FromDateMs" />
        <input type="hidden" id="ToDateMs" name="ToDateMs" />


        <div class="grid gap-[24px] grid-cols-3">
            <div class="input-field-common">
                <label class="block mb-[12px] text-sm font-medium text-secondary-100">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Action_Type
                </label>

                @Html.DropDownListFor(
                    m => m.ActionType,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text =  @CRS.ADMIN.APPLICATION.Resources.Resource.All, Value = "" },
                        new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.Phone, Value = "phone" },
                        new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.Reservation, Value = "reservation" }
                    },
                    new
                    {
                        @id = "ActionType",
                        @class = "text-[#B7B7B7] h-[44px] UserTypeDDL",
                        style = "width:100%;"
                    })
            </div>


            <div class="input-field-common">
                <label for="" class="block mb-[12px] text-sm font-medium text-secondary-100">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Target_Type
                </label>
                @Html.DropDownListFor(
                    m => m.SourcePageType,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text =@CRS.ADMIN.APPLICATION.Resources.Resource.All, Value = "" },
                        new SelectListItem { Text =@CRS.ADMIN.APPLICATION.Resources.Resource.Store_Detail, Value = "store_detail" },
                        new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.Host_Detail, Value = "host_detail" }
                    },
                    new
                    {
                        @id = "SourcePageType",
                        @class = "text-[#B7B7B7] h-[44px] UserTypeDDL",
                        style = "width:100%;"
                    })
            </div>




            <div class="input-field-common">
                <label for="" class="block mb-[12px] text-sm font-medium text-secondary-100">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.User_Status
                </label>
                @Html.DropDownListFor(
                     m => m.UserStatus,
                     new List<SelectListItem>
                     {
                         new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.All, Value = "" },
                         new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.Guest, Value = "guest" },
                         new SelectListItem { Text = @CRS.ADMIN.APPLICATION.Resources.Resource.Member, Value = "authenticated" }
                     },
                     new
                     {
                         @id = "UserStatus",
                         @class = "text-[#B7B7B7] h-[44px] UserTypeDDL",
                         style = "width:100%;"
                     })
            </div>
        </div>


        <div class="flex gap-4 mt-4">
            <button type="button"
                    class="flex items-center justify-center gap-2 border border-secondary-color-pink text-secondary-color-pink bg-white rounded-[6px] px-6 py-2 text-sm font-medium transition-colors"
                    id="ActivityLogCancelBtn">
                <i class="las la-times text-[16px]"></i>
                Cancel
            </button>
            <button type="button"
                    class="flex items-center justify-center gap-2 bg-secondary-color-pink text-white rounded-[6px] px-6 py-2 text-sm font-medium transition-colors"
                    id="ActivityLogApplyBtn">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 12V7.5H10.5V12H12V3.621L9.879 1.5H1.5V12H3ZM0.75 0H10.5L13.5 3V12.75C13.5 12.9489 13.421 13.1397 13.2803 13.2803C13.1397 13.421 12.9489 13.5 12.75 13.5H0.75C0.551088 13.5 0.360322 13.421 0.21967 13.2803C0.0790176 13.1397 0 12.9489 0 12.75V0.75C0 0.551088 0.0790176 0.360322 0.21967 0.21967C0.360322 0.0790176 0.551088 0 0.75 0ZM4.5 9V12H9V9H4.5Z" fill="white" />
                </svg>
                @CRS.ADMIN.APPLICATION.Resources.Resource.Apply
            </button>
        </div>
    </form>

</div>

<div class="flex gap-6 mt-4">

</div>
<div class="table-tab" id="all">
