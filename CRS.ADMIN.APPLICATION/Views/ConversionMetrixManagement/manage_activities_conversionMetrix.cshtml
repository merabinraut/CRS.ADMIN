            </div>
            <div class="btn btn-secondary-box-shadow" id="next-btn-2">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Next
            </div>
        </div>
    </div>
</div>


<script>
    @*let tabValue = "@ViewBag.TabValue" ?? "";
    if (tabValue == "02") {
        debugger;
        document.addEventListener('DOMContentLoaded', function () {
            const page_size2 = @ViewBag.PageSize2;
            const total_data2 = @ViewBag.TotalActivityData;
            const start_index_val2 = @ViewBag.StartIndex2;
            var clubId =  '@Model.clubId';
            let URL2 = "/ConversionMetrixManagement/Index?clubId=" + clubId;
            let search_filter2 = $('#default-search').val();
            URL2 = addQueryParam2(URL2, 'SearchFilter', search_filter2, 'TabValue', '02');
            dynamicStartIndexLabel = "StartIndex2";
            dynamicPageSizeLabel = "PageSize2";

            LoadPagination(page_size2, total_data2, start_index_val2, URL2, 'pagination-id-2', 'prev-btn-2', 'next-btn-2', 'ShowEntries-Id-2', 'Entries-Id-2');
        });
    }

    function addQueryParam2(url, paramName, paramValue, paramName2, paramValue2) {
        // Add the first query parameter
        if (paramValue != null && paramValue != "") {
            // Check if it's the first parameter, if so, use "?" else use "&"
            url += url.includes('?') ? `&${paramName}=${paramValue}` : `?${paramName}=${paramValue}`;
        }

        // Add the second query parameter
        if (paramValue2 != null && paramValue2 != "") {
            url += url.includes('?') ? `&${paramName2}=${paramValue2}` : `?${paramName2}=${paramValue2}`;
        }

        return url;
    }*@
    document.addEventListener('DOMContentLoaded', function () {
    const tabValue = '@ViewBag.TabValue';

    if (tabValue !== '02') {
        return;
    }

    const pageSize2 = @ViewBag.PageSize2;
    const totalData2 = @ViewBag.TotalActivityData;
    const startIndex2 = @ViewBag.StartIndex2;

    const params = new URLSearchParams(window.location.search);

    params.set('clubId', '@Model.clubId');
    params.set('TabValue', '02');

    const searchFilter =
        document.getElementById('default-search-activity')?.value?.trim() || '';

    if (searchFilter) {
        params.set('SearchFilter', searchFilter);
    } else {
        params.delete('SearchFilter');
    }

    params.delete('StartIndex2');
    params.delete('PageSize2');

    const paginationUrl =
        '/ConversionMetrixManagement/Index?' + params.toString();

    dynamicStartIndexLabel = 'StartIndex2';
    dynamicPageSizeLabel = 'PageSize2';

    LoadPagination(
        pageSize2,
        totalData2,
        startIndex2,
        paginationUrl,
        'pagination-id-2',
        'prev-btn-2',
        'next-btn-2',
        'ShowEntries-Id-2',
        'Entries-Id-2'
    );
});
</script>




<script>
    $('#activityLogThisMonthBtn').click(function () {
        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
        $('#FromDateMs').val(firstDay.getTime());
        $('#ToDateMs').val(today.getTime());

        $('#ClubId').val('@ViewBag.ClubId');
        $('#SearchFilter').val('@ViewBag.SearchFilter');
        $('#SearchFilter2').val('@ViewBag.SearchFilter2');
        $('#StartIndex').val('@ViewBag.StartIndex');
        $('#PageSize').val('@ViewBag.PageSize');
        $('#StartIndex2').val('@ViewBag.StartIndex2');
        $('#PageSize2').val('@ViewBag.PageSize2');
        $('#TabValue').val('@ViewBag.TabValue');

       $('#filterFormActivity').submit();
    });
</script>

<script>
    $('#ActivityLogApplyBtn').click(function () {
        const today = new Date();
        const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
