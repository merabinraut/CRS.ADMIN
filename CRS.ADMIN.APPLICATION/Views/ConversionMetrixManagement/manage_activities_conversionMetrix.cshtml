                                            <span class="text-[13px] text-[#2D3748] font-mono" title="@item.ActivityId">
                                                @(string.IsNullOrEmpty(item.ActivityId) ? "-" : item.ActivityId.Length > 14
                                            ? item.ActivityId.Substring(0, 8) + "..." + item.ActivityId.Substring(item.ActivityId.Length - 6)
                                            : item.ActivityId)
                                            </span>
                                        </div>
                                    </td>
                                    <td class="p-[12px]">
                                        @{
                                            string displayLocation = item.Prefecture;

                                            if (!string.IsNullOrEmpty(item.CustomerLocationJson))
                                            {
                                                try
                                                {
                                                    var obj = Newtonsoft.Json.Linq.JObject.Parse(item.CustomerLocationJson);

                                                    var city = obj["cityName"]?.ToString();
                                                    var country = obj["countryName"]?.ToString();

                                                    displayLocation = $"{city}, {country}";
                                                }
                                                catch
                                                {
                                                    // Keep original value
                                                }
