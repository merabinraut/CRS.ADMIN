@model CRS.ADMIN.APPLICATION.Models.ConversionMetrixManagement.ConversionMetrixOverviewModel
<div class="flex justify-between pb-[24px]">
    @*<form action="/ConversionMetrixManagement/Index" method="get">*@
        <div class="relative input-search-wrapper">
            <div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                    <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                          stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <input type="search"
                   id="activityLogSearch"
                   class="input-search block w-full "
                   placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search_By_StoreName"
                   value="@Model.SearchFilter">
        </div>
    @*</form>*@
    <div class="flex gap-6">
        <button id="activityLogThisMonthBtn"class="h-[40px] flex items-center gap-[8px] px-[12px] border border-[#D4D4D8] rounded-[5px] text-[14px] text-gray-500 font-medium">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5.625 2.5V3.125H3.125V16.875H16.875V3.125H14.375V2.5H13.125V3.125H6.875V2.5H5.625ZM4.375 4.375H5.625V5H6.875V4.375H13.125V5H14.375V4.375H15.625V5.625H4.375V4.375ZM4.375 6.875H15.625V15.625H4.375V6.875ZM8.125 8.125V9.375H9.375V8.125H8.125ZM10.625 8.125V9.375H11.875V8.125H10.625ZM13.125 8.125V9.375H14.375V8.125H13.125ZM5.625 10.625V11.875H6.875V10.625H5.625ZM8.125 10.625V11.875H9.375V10.625H8.125ZM10.625 10.625V11.875H11.875V10.625H10.625ZM13.125 10.625V11.875H14.375V10.625H13.125ZM5.625 13.125V14.375H14.375V13.125H5.625Z" fill="#A1A1AA" fill-opacity="0.75" />
            </svg>
            @CRS.ADMIN.APPLICATION.Resources.Resource.This_Month

        </button>
        @*<div class="export-button h-[40px]">
            <img src="~/Content/assets_new/images/club/download-solid.svg">@CRS.ADMIN.APPLICATION.Resources.Resource.This_Month
        </div>*@
        <div class="export-button h-[40px]" onclick="exportExcel('table-id', 'Club')">
            <img src="~/Content/assets_new/images/club/download-solid.svg">@CRS.ADMIN.APPLICATION.Resources.Resource.Export
        </div>
    </div>
</div>

<div class="border border-[#D0D5DD] rounded-[5px] p-[20px]">
    <div class="mb-4 text-[#3E3E3E] text-sm font-semibold">
        @CRS.ADMIN.APPLICATION.Resources.Resource.Filter_By
    </div>
    <div class="grid gap-[24px] grid-cols-3">
        <div class="input-field-common">
            <label for="" class="block mb-[12px] text-sm font-medium text-secondary-100 ">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Action_Type
            </label>
            <select id="activityLogActionType"
                    style="width:100%;"
                    class="text-[#B7B7B7] h-[44px] UserTypeDDL">
                <option value="">All</option>
                <option value="phone">Phone</option>
                <option value="reservation">Reservation</option>
            </select>

        </div>
        <div class="input-field-common">
            <label for="" class="block mb-[12px] text-sm font-medium text-secondary-100">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Target_Type
            </label>
            <select id="activityLogTargetType" style="width: 100%;" class="text-[#B7B7B7] h-[44px] disabled-select UserListViaTypeDDL">
                <option value="">All</option>
                <option value="store_detail">Store page</option>
                <option value="host_detail">Host Detail page</option>
            </select>
        </div>
        <div class="input-field-common">
            <label for="" class="block mb-[12px] text-sm font-medium text-secondary-100">
                @CRS.ADMIN.APPLICATION.Resources.Resource.User_Status
            </label>
            <select id="activityLogUserStatus" style="width: 100%;" class="text-[#B7B7B7] h-[44px] disabled-select UserListViaTypeDDL">
                <option value="">All</option>
                <option value="Guest">Guest</option>
                <option value="Authenticated">Member</option>
            </select>
        </div>
    </div>
    <div class="flex gap-4 mt-4">
        <button type="button"
                class="flex items-center justify-center gap-2 border border-secondary-color-pink text-secondary-color-pink bg-white rounded-[6px] px-6 py-2 text-sm font-medium transition-colors"
                id="ActivityLogCancelBtn">
            <i class="las la-times text-[16px]"></i>
            Cancel
        </button>
        <button type="button"
                class="flex items-center justify-center gap-2 bg-secondary-color-pink text-white rounded-[6px] px-6 py-2 text-sm font-medium transition-colors"
                id="ActivityLogApplyBtn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 12V7.5H10.5V12H12V3.621L9.879 1.5H1.5V12H3ZM0.75 0H10.5L13.5 3V12.75C13.5 12.9489 13.421 13.1397 13.2803 13.2803C13.1397 13.421 12.9489 13.5 12.75 13.5H0.75C0.551088 13.5 0.360322 13.421 0.21967 13.2803C0.0790176 13.1397 0 12.9489 0 12.75V0.75C0 0.551088 0.0790176 0.360322 0.21967 0.21967C0.360322 0.0790176 0.551088 0 0.75 0ZM4.5 9V12H9V9H4.5Z" fill="white" />
            </svg>
            @CRS.ADMIN.APPLICATION.Resources.Resource.Apply
        </button>
    </div>

</div>

<div class="table-tab mt-4">
    <div class="px-[12px] py-[16px] flex justify-between entry-export-container">
        <div class="flex items-center select-entries" id="ShowEntries-Id">
        </div>
    </div>
    <div class="relative overflow-x-auto">
        <table class="w-full text-left club-table table-fixed" id="activityLogTable">
            <thead class="club-table-thead">
                <tr>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">S.N
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Action_Type
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>

                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Source_Page
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Target_Name
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.User_Status
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Prefecture
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.User_Agent
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    @*<th scope="col" class="p-[12px]">
                        <div class="flex  w-max ">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Date
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>*@
                </tr>
            </thead>
            <tbody id="activityLogBody">
                @{
                    int SN = 1;
                    foreach (var item in Model.ActivityLogModel)
                    {
                        <tr class="bg-white border-b ">
                            <td class="p-[12px]">
                                @item.SNO
                            </td>
                            <td class="p-[12px]">
                                @item.ActionType
                            </td>
                            <td class="p-[12px] border-b border-gray-100">
                                <div class="flex flex-col gap-1">
                                    <!-- Renders the main source page text -->
                                    <span class="text-[14px] font-medium text-gray-900">@item.SourcePage</span>
                                    <!-- Renders the Club ID below it in muted styling -->
                                    <!-- Note: Verify if your model property is ClubId, ClubID, or Club_Id -->
                                    <span class="text-[12px] text-gray-500">ID: @item.ClubCode</span>
                                </div>
                            </td>
                            <td class="p-[12px]">
                                @item.TargetName
                            </td>
                            <td class="p-[12px] text-center border-b border-gray-100">
                                <div class="flex flex-col items-center justify-center gap-1">
                                    <!-- Renders the badge dynamically -->
                                    <div>
                                        <script>document.write(userStatusBadge('@item.UserStatus'));</script>
                                    </div>
                                    <!-- Renders the session ID text below it -->
                                    <span class="text-[13px] text-[#2D3748] font-mono" title="@item.ActivityId">
                                        @(string.IsNullOrEmpty(item.ActivityId) ? "-" : item.ActivityId.Length > 14
                ? item.ActivityId.Substring(0, 8) + "..." + item.ActivityId.Substring(item.ActivityId.Length - 6)
                : item.ActivityId)
                                    </span>
                                </div>
                            </td>
                            <td class="p-[12px]">
                                <div class="w-max">
                                    @item.Prefecture
                                </div>
                            </td>
                            <td class="p-[12px]">
                                <div class="w-max">
                                    @item.UserAgent
                                </div>
                            </td>
                            @*<td class="p-[12px]">
                                <div class="w-max">
                                    @item.Date
                                </div>
                            </td>*@
                        </tr>
                        SN++;
                    }
                }
            </tbody>
        </table>

    </div>
    <div class="pagination-club">
        <div class="show-entry" id="Entries-Id">
        </div>
        <div class="flex gap-[12px]">
            <div class="btn btn-secondary-box-shadow" id="activityLogPrevBtn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Previous
            </div>
            <div class="flex gap-[12px]" id="activityLogPaginationId">
            </div>
            <div class="btn btn-secondary-box-shadow" id="activityLogNextBtn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Next
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var currentPage = 1;
        var pageSize = 10;
        var currentActionType = '';
        var currentTargetType = '';
        var currentUserStatus = '';
        var currentSearch = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.SearchFilter))';
        var searchDebounce = null;
        var thisMonthActive = false;
        var fromDateMs = null;  
        var toDateMs = null; 

        function escHtml(s) {
            return $('<div>').text(String(s || '')).html();
        }

        function formatDate(d) {
            if (!d) return '-';
            var dt = new Date(d);
            if (isNaN(dt.getTime())) return escHtml(d);
            return dt.toLocaleString();
        }

        function getThisMonthRange() {
            var now = new Date();
            var start = new Date(now.getFullYear(), now.getMonth(), 1, 0, 0, 0, 0);
            var end = new Date(now.getFullYear(), now.getMonth() + 1, 0, 23, 59, 59, 999);
            return { from: start.getTime(), to: end.getTime() };
        }


        function loadActivityLog(pageNo) {
            currentPage = pageNo || 1;
            var tzOffset = -new Date().getTimezoneOffset();

            $.ajax({
                url: '/ConversionMetrixManagement/GetActiveLog',
                type: 'GET',
                data: {
                    clubId: window.selectedClubId,
                    actionType: currentActionType,
                    sourcePageType: currentTargetType,
                    userStatus: currentUserStatus,
                    fromDateMs: fromDateMs,
                    toDateMs: toDateMs,
                    timezoneOffset: tzOffset,
                    search: currentSearch,
                    pageNo: currentPage,
                    pageSize: pageSize
                },
                success: function (response) {
                    if (!response || response.success === false) {
                        console.error('[ActivityLog] server error:', response && response.message);
                        renderRows([]);
                        renderPagination(0);
                        return;
                    }
                    renderRows(response.data);
                    renderPagination(response.totalCount);
                },
                error: function (xhr, status, err) {
                    console.error('[ActivityLog] AJAX error:', status, err);
                    renderRows([]);
                    renderPagination(0);
                }
            });
        }
        function actionTypeBadge(actionType) {
            // Base layout style for pill components
            var baseStyle = 'display:inline-flex;align-items:center;gap:6px;padding:4px 14px;border-radius:999px;font-size:13px;font-weight:500;';

            // "Phone Call" -> "電話" with your phone SVG
            if (actionType === 'Phone Call' || actionType === 'Phone') {
                return '<span class="badge-pill" style="' + baseStyle + 'background:#E6F7EE;color:#101828;border:1px solid #C4EED8;">'
                    + '<svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">'
                    + '<path d="M2.13111 0C1.93461 0 1.74111 0.07 1.58011 0.199L1.55661 0.211L1.54511 0.2225L0.373105 1.43L0.385105 1.4415C0.213228 1.59757 0.0914385 1.80107 0.0351092 2.02629C-0.0212201 2.25152 -0.00956433 2.48839 0.0686052 2.707C0.0701052 2.71 0.0671052 2.716 0.0686052 2.719C0.386605 3.6285 1.19961 5.385 2.78711 6.9725C4.3811 8.5665 6.16061 9.3475 7.04111 9.6915H7.05311C7.27371 9.76439 7.50943 9.77894 7.73732 9.73373C7.96522 9.68852 8.17753 9.58509 8.35361 9.4335L9.53711 8.25C9.84811 7.9395 9.84811 7.4 9.53711 7.09L8.0141 5.5665L8.0021 5.543C7.6916 5.2325 7.14061 5.2325 6.83011 5.543L6.08011 6.293C5.51717 6.02246 4.9994 5.6666 4.5451 5.238C3.9311 4.6525 3.61811 3.9785 3.50211 3.715L4.25211 2.965C4.56711 2.65 4.57311 2.1255 4.24061 1.8165L4.25211 1.8045L4.2171 1.7695L2.71711 0.2225L2.70511 0.211L2.68161 0.199C2.52605 0.0720387 2.33189 0.00185092 2.13111 0ZM2.13111 0.75C2.15911 0.75 2.18661 0.763 2.21311 0.785L3.71311 2.32L3.74811 2.355C3.74511 2.3525 3.77011 2.392 3.72461 2.4375L2.78711 3.375L2.61161 3.539L2.69361 3.7735C2.69361 3.7735 3.1241 4.926 4.0296 5.789L4.11161 5.859C4.98311 6.655 6.01011 7.09 6.01011 7.09L6.24411 7.195L7.3576 6.082C7.4221 6.0175 7.41011 6.0175 7.47461 6.082L9.00961 7.617C9.0746 7.682 9.0746 7.658 9.00961 7.7225L7.8616 8.871C7.6886 9.019 7.50561 9.05 7.28711 8.9765C6.43761 8.6425 4.78711 7.9175 3.31461 6.4455C1.83061 4.9615 1.05561 3.2785 0.771605 2.4605C0.714605 2.3085 0.755605 2.083 0.889105 1.9685L0.912105 1.9455L2.04911 0.7855C2.07146 0.764458 2.10047 0.751899 2.13111 0.75Z" fill="#089364"/>'
                    + '</svg>'
                    + '\u96fb\u8a71</span>';
            }

            // "Reservation" -> "予約" with your reservation SVG
            if (actionType === 'Reservation' || actionType === 'reservation') {
                return '<span class="badge-pill" style="' + baseStyle + 'background:#FFF5EC;color:#101828;border:1px solid #FFE3CC;">'
                    + '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">'
                    + '<path d="M6 1.5C3.5185 1.5 1.5 3.5185 1.5 6C1.5 8.4815 3.5185 10.5 6 10.5C8.4815 10.5 10.5 8.4815 10.5 6C10.5 3.5185 8.4815 1.5 6 1.5ZM6.1525 2.2615C6.5125 2.2765 6.857 2.329 7.1835 2.4375L7.008 2.6835L7.148 2.9765L6.961 3.3515L7.758 3.457L8.051 4.8165L8.6955 5.6955L9.2695 6.0585L9.047 5.4375L9.258 5.1795L9.6915 5.297C9.734 5.524 9.75 5.7615 9.75 6C9.75 6.0555 9.741 6.11 9.7385 6.164L9.7035 6.094L9.34 6.246L9.246 6.4805L9.047 6.5505L9.117 7.1605L9.2695 7.383L9.1645 7.676L8.6015 8.566L8.5545 8.742C7.86179 9.39003 6.94857 9.75038 6 9.75C5.45567 9.75111 4.91768 9.63317 4.42372 9.40446C3.92977 9.17576 3.4918 8.8418 3.1405 8.426L2.6135 7.125L2.918 6.6095L2.461 6.3515L2.9765 6.1055L3 5.824L2.8475 5.426L3.1405 5.461L3.4335 5.906L3.7035 6.035L3.621 5.73L3.9025 5.449L4.3595 5.7775L4.6055 5.578L4.5 5.0625L4.8635 4.547L4.8165 4.0315L5.2615 3.7615L4.957 3.0115L5.801 2.965L6.2695 2.367L6.1525 2.262V2.2615ZM5.625 5.8475L4.629 6.5975L4.699 7.535L4.957 7.758L5.5315 7.453L5.824 7.535L6.328 8.074L6.633 7.992L6.949 7.242L6.75 6.727L6.3515 5.953L6.0585 6.422L5.625 5.8475ZM7.5 7.43L7.43 7.4535L7.4065 7.934L7.242 8.1565L7.4295 8.3325L7.6645 8.063L7.5 7.43ZM7.09 8.3445L6.6095 8.895L6.7385 9.0355L7.301 8.4965L7.09 8.3445Z" fill="#E75F0F"/>'
                    + '</svg>'
                    + '\u4e88\u7d04</span>';
            }

            // Fallback default style
            return '<span class="badge-pill" style="' + baseStyle + 'background:#F4F4F5;color:#6B7280;border:1px solid #E4E4E7;">'
                + escHtml(actionType || '-') + '</span>';
        }

        function userStatusBadge(statusType) {
            // Base layout style for the small text-only pills
            var baseStyle = 'display:inline-flex;align-items:center;justify-content:center;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:500;line-height:1.2;';

            // "Member" -> "会員" (\u4f1a\u54e1)
            if (statusType === 'Member' || statusType === 'member' || statusType === '会員' || statusType === 'Authenticated') {
                return '<span class="status-pill" style="' + baseStyle + 'background:#E6F7EE;color:#1D9E75;">\u4f1a\u54e1</span>';
            }

            // "Guest" -> "ゲスト" (\u30b2\u30b9\u30c8)
            if (statusType === 'Guest' || statusType === 'guest' || statusType === 'ゲスト') {
                return '<span class="status-pill" style="' + baseStyle + 'background:#FFF5EC;color:#B25E12;">\u30b2\u30b9\u30c8</span>';
            }

            // Fallback default style
            return '<span class="status-pill" style="' + baseStyle + 'background:#F4F4F5;color:#6B7280;">'
                + escHtml(statusType || '-') + '</span>';
            }
        function formatActivityId(id) {
            if (!id || id === '-') return '-';
            if (id.length <= 14) return escHtml(id);
            return escHtml(id.substring(0, 8) + '...' + id.substring(id.length - 6));
        }


        function renderRows(rows) {
            if (!rows || !rows.length) {
                $('#activityLogBody').html(
                    '<tr><td colspan="7" class="p-[16px] text-center text-gray-400 text-[13px]">No data available.</td></tr>'
                );
                return;
            }

            var html = rows.map(function (r) {
                return '<tr class="bg-white border-b">'
                    + '<td class="p-[12px]">' + r.sn + '</td>'
                    + '<td class="p-[12px]">' + actionTypeBadge(r.actionType) + '</td>'
                //+ '<td class="p-[12px]">' + escHtml(r.sourcePage) + '</td>'
                    + '<td class="p-[12px] border-b border-gray-100">'
                    + '    <div class="flex flex-col gap-1">'
                    + '        <span class="text-[14px] font-medium text-gray-900">' + escHtml(r.sourcePage) + '</span>'
                    + '        <span class="text-[12px] text-gray-500">ID: ' + escHtml(r.clubCode || '-') + '</span>'
                    + '    </div>'
                    + '</td>'
                    + '<td class="p-[12px]">' + escHtml(r.targetName) + '</td>'
                //+ '<td class="p-[12px]">' + userStatusBadge(r.userStatus, r.sessionId) + '</td>'
                    + '<td class="p-[12px] text-center border-b border-gray-100">'
                    + '    <div class="flex flex-col items-center justify-center gap-1">'
                    + '        <div>' + userStatusBadge(r.userStatus) + '</div>'
                    + '        <span class="text-[13px] text-[#2D3748] font-mono" title="' + escHtml(r.activityId || '-') + '">' + formatActivityId(r.activityId) + '</span>'
                    + '    </div>'
                    + '</td>'
                    + '<td class="p-[12px] truncate max-w-[150px]">' + escHtml(r.prefecture) + '</td>'
                    + '<td class="p-[12px] truncate max-w-[250px]" title="' + escHtml(r.userAgent) + '">' + escHtml(r.userAgent) + '</td>'
                    //+ '<td class="p-[12px] whitespace-nowrap">' + formatDate(r.date) + '</td>'
                    + '</tr>';
            }).join('');

            $('#activityLogBody').html(html);
        }

        function renderPagination(totalCount) {
            var totalPages = Math.max(1, Math.ceil(totalCount / pageSize));

            $('#Entries-Id').text(
                totalCount > 0
                    ? ((currentPage - 1) * pageSize + 1) + '-' + Math.min(currentPage * pageSize, totalCount) + ' of ' + totalCount
                    : '0 of 0'
            );

            var pages = getPageNumbers(currentPage, totalPages);
            var pagesHtml = pages.map(function (p) {
                if (p === '...') {
                    return '<div class="px-2 text-gray-400 select-none self-center">...</div>';
                }
                var activeClass = p === currentPage ? 'btn-primary' : 'btn-secondary-box-shadow';
                return '<div class="btn ' + activeClass + ' activity-log-page-btn" data-page="' + p + '">' + p + '</div>';
            }).join('');

            $('#activityLogPaginationId').html(pagesHtml);
            $('#activityLogPrevBtn').toggleClass('disabled', currentPage <= 1);
            $('#activityLogNextBtn').toggleClass('disabled', currentPage >= totalPages);
        }

        function getPageNumbers(current, total) {
            var delta = 2; 
            var range = [1];

            for (var i = current - delta; i <= current + delta; i++) {
                if (i > 1 && i < total) {
                    range.push(i);
                }
            }

            if (total > 1) {
                range.push(total);
            }

            var withDots = [];
            var last = null;
            range.forEach(function (page) {
                if (last !== null) {
                    if (page - last === 2) {
                        withDots.push(last + 1);
                    } else if (page - last > 2) {
                        withDots.push('...');
                    }
                }
                withDots.push(page);
                last = page;
            });

            return withDots;
        }

        $(document).on('click', '.activity-log-page-btn', function () {
            loadActivityLog(parseInt($(this).data('page'), 10));
        });

        $(document).on('click', '#activityLogPrevBtn', function () {
            if (currentPage > 1) loadActivityLog(currentPage - 1);
        });

        $(document).on('click', '#activityLogNextBtn', function () {
            loadActivityLog(currentPage + 1);
        });

        $(document).on('click', '#ActivityLogApplyBtn', function () {
            currentActionType = $('#activityLogActionType').val();
            currentTargetType = $('#activityLogTargetType').val();
            currentUserStatus = $('#activityLogUserStatus').val();
            loadActivityLog(1);
        });

        $(document).on('click', '#ActivityLogCancelBtn', function () {
            $('#activityLogActionType').val('');
            $('#activityLogTargetType').val('');
            $('#activityLogUserStatus').val('');
            currentActionType = '';
            currentTargetType = '';
            currentUserStatus = '';  
            loadActivityLog(1);
        });

        $(document).on('input', '#activityLogSearch', function () {
            var val = $(this).val();
            clearTimeout(searchDebounce);
            searchDebounce = setTimeout(function () {
                currentSearch = val;
                loadActivityLog(1);
            }, 300);
        });
        $(document).on('click', '#activityLogThisMonthBtn', function () {
            thisMonthActive = !thisMonthActive;

            if (thisMonthActive) {
                var range = getThisMonthRange();
                fromDateMs = range.from;
                toDateMs = range.to;
                $(this).addClass('bg-secondary-color-pink text-white border-secondary-color-pink')
                    .removeClass('text-gray-500 border-[#D4D4D8]');
            } else {
                fromDateMs = null;
                toDateMs = null;
                $(this).removeClass('bg-secondary-color-pink text-white border-secondary-color-pink')
                    .addClass('text-gray-500 border-[#D4D4D8]');
            }

            loadActivityLog(1);
        });


        $(document).ready(function () {
            loadActivityLog(1);
        });

        window.reloadActivityLog = function () {
            loadActivityLog(currentPage);
        };
    })();
</script>