                                            if (!string.IsNullOrEmpty(item.CustomerLocationJson))
                                            {
                                                try
                                                {
                                                    var location = JObject.Parse(item.CustomerLocationJson);
                                                    cityName = location["cityName"]?.ToString();
                                                }
                                                catch
                                                {
                                                }
                                            }
                                        }

                                        @item.TargetName
                                        @if (!string.IsNullOrEmpty(cityName))
                                        {
                                            <span>(@cityName)</span>
                                        }
                                    </td>*@

                                <td class="p-[12px]">
                                    @item.TargetName

                                    @if (!string.IsNullOrEmpty(item.Prefecture))
                                    {
                                        <span>(@item.Prefecture)</span>
                                    }
                                </td>

                                    <td class="p-[12px] text-center border-b border-gray-100">
                                        <div class="flex flex-col items-center justify-center gap-1">
                                            <div>
                                                @if (!string.IsNullOrEmpty(item.UserStatus) && item.UserStatus.ToLower() == "member")
                                                {
                                                    <span class="badge badge-success approved items-center gap-1">
                                                        @CRS.ADMIN.APPLICATION.Resources.Resource.Member
                                                    </span>
                                                }
                                                else if (!string.IsNullOrEmpty(item.UserStatus) && item.UserStatus.ToLower() == "guest")
                                                {
                                                    <span class="badge badge-warning pending items-center gap-1">
                                                        @CRS.ADMIN.APPLICATION.Resources.Resource.Guest
