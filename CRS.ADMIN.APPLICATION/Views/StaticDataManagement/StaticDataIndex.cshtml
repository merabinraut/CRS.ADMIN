@model CRS.ADMIN.APPLICATION.Models.StaticDataManagement.StaticDataManagement
@{
    ViewBag.Title = "StaticDataIndex";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _manageStaticDataModel = Model.ManageStaticData as CRS.ADMIN.APPLICATION.Models.StaticDataManagement.ManageStaticData;
}

<div class="px-8 py-4">
    @Html.AntiForgeryToken()
    <div>
        <div class="heading-title">
            @CRS.ADMIN.APPLICATION.Resources.Resource.StaticDataType
        </div>
        <div class="span-title-light-gray">
            @CRS.ADMIN.APPLICATION.Resources.Resource.ManageStaticDataType
        </div>
    </div>
    <!-- container  -->
    <div class="flex justify-between pt-[24px] pb-[24px]">
        <form action="/StaticDataManagement/Index" method="get">
            <div class="relative input-search-wrapper">
                @*<div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                        <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                              stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round">
                        </path>
                    </svg>
                </div>
                <input type="search"
                       id="default-search"
                       class="input-search block w-full "
                       placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search"
                       value=""
                       name="SearchText">*@
            </div>
        </form>
        <div class="btn btn-primary gap-[8px] h-[40px]" data-drawer-target="add-new_static_data"
             data-drawer-show="add-new_static_data" data-drawer-placement="right" data-drawer-backdrop="false"
             aria-controls="drawer-disabled-backdrop">
            <img src="~/Content/assets_new/images/plus-circle-solid.svg">
            @CRS.ADMIN.APPLICATION.Resources.Resource.Add_New
        </div>
    </div>
    <div class="table-tab">
        <div class="px-[16px] py-[12px] flex justify-between entry-export-container">
            <div class="flex items-center select-entries" id="ShowEntries-Id">
            </div>
            <div class="export-button h-[40px]">
                <img src="~/Content/assets_new/images/club/download-solid.svg"> @CRS.ADMIN.APPLICATION.Resources.Resource.Export
            </div>
        </div>
        <div class="relative overflow-x-auto">
            <table class="w-full  text-left club-table" id="table-id">
                <thead class="club-table-thead">
                    <tr>
                        <th scope="col" class="p-[12px]">
                            <div class="flex w-max">
                                S.N
                                <div class="relative pl-[5px]">
                                    <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                    <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                </div>
                            </div>
                        </th>
                        @*<th scope="col" class="p-[12px]">
                            <div class="flex w-max">
                                Static Data Type Id
                                <div class="relative pl-[5px]">
                                    <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                    <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                </div>
                            </div>
                        </th>*@
                        <th scope="col" class="p-[12px]">
                            <div class="flex w-max">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.StaticDataLabel
                                <div class="relative pl-[5px]">
                                    <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                    <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                </div>
                            </div>
                        </th>
                        <th scope="col" class="p-[12px]">
                            <div class="flex w-max">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.StaticDataDescription
                                <div class="relative pl-[5px]">
                                    <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                    <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                </div>
                            </div>
                        </th>
                        <th scope="col" class="p-[12px]">
                            <div class="flex justify-center">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.Action
                                <div class="relative pl-[5px]">
                                    <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                    <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                </div>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sno = 1;
                        foreach (var item in Model.GetStaticDataList)
                        {
                            <tr class="bg-white border-b ">
                                <td class="p-[12px]">
                                    @sno
                                </td>
                                @*<td class="p-[12px]">
                                    @item.StaticDataType
                                </td>*@
                                <td class="p-[12px]">
                                    @item.StaticDataLabel
                                </td>
                                <td class="p-[12px]">
                                    @item.StaticDataDescription
                                </td>
                                <td class="p-[12px]">
                                    <div class="flex gap-[7px] justify-center text-[16px] ">
                                        <div>
                                            <i class="fa-regular fa-pen-to-square text-[#989898] cursor-pointer" onclick="edit('@item.Id','@item.StaticDataType')"></i>
                                        </div>
                                        <div>
                                            @*<i class="fa-solid fa-trash-can text-primary-100 cursor-pointer" onclick="deleteStaticData('@item.Id')"></i>*@

                                            <div onclick="deleteStaticDetail('@item.Id')" data-modal-target="delete-static-detail" data-modal-toggle="delete-static-detail">
                                                <i class="fa-solid fa-trash-can text-primary-100 cursor-pointer"></i>
                                            </div>

                                        </div>
                                    </div>
                                </td>
                            </tr>
                            sno++;
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="pagination-club">
            <div class="show-entry" id="Entries-Id">
            </div>
            <div class="flex gap-[12px]">
                <div class="btn btn-secondary-box-shadow" id="prev-btn">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Previous
                </div>
                <div class="flex gap-[12px]" id="pagination-id">
                </div>
                <div class="btn btn-secondary-box-shadow" id="next-btn">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Next
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_ManageStaticData", _manageStaticDataModel)

<div id="delete-static-detail" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full
     p-4 overflow-x-hidden overflow-y-auto
     md:inset-0 h-[calc(100%-1rem)] max-h-full " style="align-items: flex-start;">
    <div class="relative max-w-2xl max-h-full w-[412px] px-4 pt-[40px] pb-[46px] mt-24">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow">
            <!-- Modal header -->
            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center absolute top-[24px] right-[20px] "
                    data-modal-hide="delete-static-detail">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
                    <rect y="0.621094" width="24" height="24" rx="12" fill="#FAFAFA" />
                    <path d="M5.41406 4.95703L4.33594 6.03516L10.9219 12.6211L4.33594 19.207L5.41406 20.2852L12 13.6992L18.5859 20.2852L19.6641 19.207L13.0781 12.6211L19.6641 6.03516L18.5859 4.95703L12 11.543L5.41406 4.95703Z"
                          fill="#7A7A7A" />
                </svg>
            </button>
            <!-- Modal body -->
            <div class="grid gap-6 px-[20px] py-8">
                <div class="text-[#333] font-semibold pb-[11px] border-b border-[#eeeeee]">@CRS.ADMIN.APPLICATION.Resources.Resource.Confirmation</div>
                <div class="grid gap-[20px] text-[#062937] mb-[45px]">
                    <div class="text-[14px] text-secondary-text-2 text-start" id="deleteRequestMessage">
                        @*@CRS.ADMIN.APPLICATION.Resources.Resource.PlanRequestConfirmationMessage*@「この静的データを本当に削除してもよろしいですか？」
                    </div>
                </div>
                <div class="flex justify-end">
                    <div class="flex gap-2 justify-end mt-[45px]">
                        <input id="request_ids" value="" hidden />
                        <div class="btn btn-secondary w-[110px]" id="delete_ids1" data-modal-hide="delete-static-detail">@CRS.ADMIN.APPLICATION.Resources.Resource.clubNo</div>
                        <div class="btn btn-primary w-[110px]" onclick="deleteStaticData()" data-vals1="" data-vals2="" data-vals3="" id="delete_ids1">@CRS.ADMIN.APPLICATION.Resources.Resource.clubYes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
         $(document).ready(function () {
             $('select').select2({
                 minimumResultsForSearch: Infinity
             })
             var popUpRenderValue = '@ViewBag.PopUpRenderValue1';
             if (popUpRenderValue != null && popUpRenderValue != "" && popUpRenderValue == "Manage") {
                 var element = document.getElementById('add-new_static_data');
                 element.classList.remove('translate-x-full');
             }
         });
        function edit(id, staticDataTypeId) {
            window.location.href = '/StaticDataManagement/ManageStaticData?id=' + id + '&staticDataTypeId=' + staticDataTypeId;
        }
        document.getElementById('CancelId').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });


        function deleteStaticDetail(staticId) {
            const $modal = $("#delete-static-detail");
            const $message = $("#confirmationRequestMessage");
            const $approveBtn = $("#delete_ids1");
            const contentApprove = "Are you sure want to delete static data?";
            $message.text(contentApprove);
            $approveBtn.attr({
                "data-vals1": staticId,
                "data-vals2": status,
            });
            $modal.removeClass("hidden").attr("aria-hidden", "false");
        }





        function deleteStaticData() {
            const staticId = $('#delete_ids1').attr('data-vals1');
            $.ajax({
                type: 'POST',
                async: true,
                url: "/StaticDataManagement/DeleteStaticData?id="+ staticId,
                dataType: 'json',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                },
                success: function () {
                    window.location.reload();
                },
                error: function (ex) {

                }
            });
        }
    </script>
}

