@model CRS.ADMIN.APPLICATION.Models.RecommendationManagementV2.CommonRecommendationModel
<style>
    .tag-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 4px;
        background: #DCE8FF;
        color: #245EDC;
        font-family: "Noto Sans";
        font-size: 12px;
        font-style: normal;
        font-weight: 400;
        line-height: 20px;
        white-space: nowrap;
    }
</style>
<div class="divider-common m-0 h-[1px]">

</div>

<form action="/RecommendationManagementV2/IndexCopy" method="get">
    <div class="relative input-search-wrapper flex justify-between">
        <div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                      stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <input type="search"
               id="default-search-editor-pick"
               class="input-search block w-full "
               placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search"
               value="@ViewBag.SearchFilter"
               name="SearchFilter">

        <div class="flex gap-6 bg-blue">
            <div class="btn btn-primary gap-[8px] h-[40px]" data-drawer-target="add-manage-editor-page"
                 data-drawer-show="add-manage-editor-page" data-drawer-placement="right" data-drawer-backdrop="false"
                 aria-controls="drawer-disabled-backdrop">
                <img src="~/Content/assets_new/images/plus-circle-solid.svg" />
                @CRS.ADMIN.APPLICATION.Resources.Resource.Add_Editor
            </div>
        </div>

    </div>
</form>

<div class="divider-common m-0 h-[1px]">

</div>





<div class="table-tab" id="all">
    <div class="px-[16px] py-[12px] flex justify-between entry-export-container">
        <div class="flex items-center select-entries" id="ShowEntries-Id">
        </div>
    </div>
    <div class="relative overflow-x-auto">
        <table class="w-full  text-left club-table">
            <thead class="club-table-thead">
                <tr>
                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            S.N
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Club_Profile
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Description
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Editor_Tags
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>

                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Updated_Date
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>

                    <th scope="col" class="p-[12px]">
                        <div class="flex">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Action
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int sno2 = 1;
                    foreach (var item in Model.GetRecommendationEditorPickResponseList)
                    {
                        <tr class="bg-white border-b ">
                            <td class="p-[12px]">
                                @sno2
                            </td>
                            <td class="p-[12px]">
                                <div class="round-image-text flex gap-[12px] w-max ">
                                    <img class="w-[32px] h-[32px] rounded-full" src="@item.ClubLogo" />

                                    <div class="flex justify-between w-full">
                                        <div class="text-image grid flex-none">
                                            <div class="text-sm font-semibold text-[#101828] ">@item.ClubName</div>
                                            @*<div class="platinum ">@item.ClubCategory</div>*@
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-[12px]">
                                <div class="max-w-[300px] break-words whitespace-normal">
                                    @item.Description
                                </div>
                            </td>
                            <td class="p-[12px]">
                                @if (!string.IsNullOrWhiteSpace(item.Tags))
                                {
                                    var tags = item.Tags
                                        .Split(',')
                                        .Select(x => x.Trim())
                                        .Where(x => !string.IsNullOrWhiteSpace(x));

                                    <div class="flex flex-wrap gap-[8px]">
                                        @foreach (var tag in tags)
                                        {
                                            <span class="tag-badge">@tag</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="p-[12px]">
                                <div class="w-max">
                                    @item.UpdatedDate
                                </div>
                            </td>
                            <td class="p-[12px]">
                                <div class="flex gap-2 items-center">
                                    <i class="fa-regular fa-pen-to-square text-[20px] text-[#989898] cursor-pointer" onclick="EditEditorPick('@item.EditorPickId')"></i>
                                <div>        
                                   <i class=" las la-trash-alt text-[20px] cursor-pointer text-[#CB3F3F]" onclick="DeletePickerFunction('@item.EditorPickId','D');" data-modal-target="delete-editor-pick-confirmation1" data-modal-toggle="delete-editor-pick-confirmation1"></i>
                                </div>
                                </div>
                            </td>
                        </tr>
                        sno2++;
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-club">
        <div class="show-entry" id="Entries-Id">
        </div>
        <div class="flex gap-[12px]">
            <div class="btn btn-secondary-box-shadow" id="prev-btn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Previous
            </div>
            <div class="flex gap-[12px]" id="pagination-id">
            </div>
            <div class="btn btn-secondary-box-shadow" id="next-btn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Next
            </div>
        </div>
    </div>
</div>


<script>
    function EditEditorPick(editorpickId) {
        console.log(editorpickId, "editorid");
        window.location.href = "/RecommendationManagementV2/ManageRecommendationV2?editorPickId=" + editorpickId;
    }

    //function DeleteEditorPickDetail(editorpickId) {
    //    const modal = document.getElementById("delete-editor-pick-confirmation");
    //    if (modal) {
    //        modal.classList.remove("hidden");
    //        modal.classList.add("flex");
    //        modal.setAttribute("aria-hidden", "false");
    //    }
    //    $('#delete_editor_id').attr('data-val', editorpickId);
    //}


</script>
