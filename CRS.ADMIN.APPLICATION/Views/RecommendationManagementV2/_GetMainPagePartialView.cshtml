                                    <th scope="col" class="p-[12px]">
                                        <div class="flex">
                                            @CRS.ADMIN.APPLICATION.Resources.Resource.Display_Page
                                            <div class="relative pl-[5px]">
                                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                            </div>
                                        </div>
                                    </th>
                                    <th scope="col" class="p-[12px]">
                                        <div class="flex">
                                            @CRS.ADMIN.APPLICATION.Resources.Resource.Action
                                            <div class="relative pl-[5px]">
                                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                            </div>
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int sno1 = 1;
                                    foreach (var item in Model.GetClubRecommendationrequestList)
                                    {
                                        <tr class="bg-white border-b ">
                                            <td class="p-[12px]">
                                                @sno1
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="round-image-text flex gap-[12px] w-max ">
                                                    <img class="w-[32px] h-[32px] rounded-full" src="@item.ClubLogo" />

                                                    <div class="flex justify-between w-full">
                                                        <div class="text-image grid flex-none">
                                                            <div class="text-sm font-semibold text-[#101828] ">@item.ClubName</div>
                                                            <div class="platinum ">@item.ClubCategory</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="w-max">
                                                    @item.LocationName
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "APPROVED")
                                                {
                                                    <div class="approved">
                                                        "A"
                                                    </div>
                                                }
                                                else if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "PENDING")
                                                {
                                                    <div class="pending">
                                                        "P"
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="rejected">
                                                        "R"
                                                    </div>
                                                }
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="w-max">
                                                    @item.RequestedDate
                                                </div>
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="w-max">
                                                    @item.UpdatedDate
                                                </div>
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="w-max">
                                                    @item.DisplayPage
                                                </div>
                                            </td>
                                            <td class="p-[12px]">
                                                <div class="flex gap-2 items-center">
                                                    @{
                                                        if (!string.IsNullOrEmpty(item.DisplayPage) && item.DisplayPage.Trim().ToUpper() == "MAIN PAGE")
                                                        {
                                                            if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "PENDING")
                                                            {
                                                                <i class="fa-regular fa-pen-to-square text-[20px] text-[#989898] cursor-pointer" onclick="GotoMainPageRecommendationReqUpdate('@item.ClubId','@item.LocationId','@item.DisplayId','@item.RecommendationHoldId')"></i>
                                                            }

                                                        }
                                                        else if (!string.IsNullOrEmpty(item.DisplayPage) && item.DisplayPage.Trim().ToUpper() == "SEARCH RESULT PAGE")
                                                        {
                                                            if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "PENDING")
                                                            {
                                                                <i class="las la-window-close text-[24px] text-[#CB3F3F] cursor-pointer " data-modal-target="popup-modal-reject" data-modal-toggle="popup-modal-reject" alt="" onclick="rejectReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')"></i>
                                                                <img src="/Content/assets_new/images/check-square.svg"
                                                                     data-modal-target="popup-modal-accept"
                                                                     data-modal-toggle="popup-modal-accept" alt="" class="cursor-pointer" onclick="acceptReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')">

                                                            }
                                                        }
                                                        else
                                                        {
                                                            if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "PENDING")
                                                            {
                                                                <i class="las la-window-close text-[24px] text-[#CB3F3F] cursor-pointer " data-modal-target="popup-modal-reject" data-modal-toggle="popup-modal-reject" alt="" onclick="rejectReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')"></i>
                                                                <img src="/Content/assets_new/images/check-square.svg"
                                                                     data-modal-target="popup-modal-accept"
                                                                     data-modal-toggle="popup-modal-accept" alt="" class="cursor-pointer" onclick="acceptReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')">
                                                            }
                                                        }
                                                    }

                                                </div>
                                            </td>
                                        </tr>
                                        sno1++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="pagination-club">
                    </div>
                </div>
