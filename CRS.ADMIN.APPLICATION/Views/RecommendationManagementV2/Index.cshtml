
@model CRS.ADMIN.APPLICATION.Models.RecommendationManagementV2.CommonRecommendationModel
@{
    ViewBag.Title = "IndexCopy";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string approved = "Approved";
    string pending = "Pending";
    string rejected = "Rejected";

    var _manageRecommendation = Model.addEditorPick as CRS.ADMIN.APPLICATION.Models.RecommendationManagementV2.AddEditorPick;

}

<div class="px-8 py-4">
    @Html.AntiForgeryToken()
    <div class="flex flex-col  gap-6">
        <div class="flex justify-between items-center">
            <div>
                <div class="heading-title">@CRS.ADMIN.APPLICATION.Resources.Resource.Recommendation_Requests</div>
                <div class="span-title-light-gray">@CRS.ADMIN.APPLICATION.Resources.Resource.RecommendationSupportMsg</div>
            </div>
        </div>

        <div id="tabV1" class="tab-content-planeV3">
            <div class="flex flex-col gap-8">
                <div id="tabV1" class="tab-content">
                    <div class="flex gap-4 mb-8 border-b">

                        <div id="tabMainLink" class="styleCss px-1 pb-4 cursor-pointer active" onclick="changeTabV1('all', 'tabMainLink')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Main_Page
                        </div>

                        <div id="tabEditorLink" class="styleCss px-1 pb-4 cursor-pointer" onclick="changeTabV1('request1','tabEditorLink')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Editors_Pick
                        </div>
                    </div>
                    <div class="flex justify-between pb-[10px]">

                    </div>

                    <div class="pane active table-tab gap-1 " id="all">
                        @if (!string.IsNullOrEmpty(Convert.ToString(Model.GetClubRecommendationrequestList)))
                        {
                            @Html.Partial("_GetMainPagePartialView", Model)
                        }
                    </div>

                    <div class="pane" id="request1" style="display: none;">
                        @if (!string.IsNullOrEmpty(Convert.ToString(Model.GetRecommendationEditorPickResponseList)))
                        {
                            @Html.Partial("_GetEditorPickPartialView", Model)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="flex justify-between pb-[10px]">


</div>

<div id="delete-editor-pick-confirmation1" tabindex="-1" aria-hidden="false" class="fixed top-0 left-0 right-0 z-50 hidden w-full
     p-4 overflow-x-hidden overflow-y-auto
     md:inset-0 h-[calc(100%-1rem)] max-h-full " style="align-items: flex-start;">
    <div class="relative max-w-2xl max-h-full w-[412px] px-4 pt-[40px] pb-[46px] mt-24">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow">
            <!-- Modal header -->
            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center absolute top-[24px] right-[20px] "
                    data-modal-hide="delete-editor-pick-confirmation1">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
                    <rect y="0.621094" width="24" height="24" rx="12" fill="#FAFAFA" />
                    <path d="M5.41406 4.95703L4.33594 6.03516L10.9219 12.6211L4.33594 19.207L5.41406 20.2852L12 13.6992L18.5859 20.2852L19.6641 19.207L13.0781 12.6211L19.6641 6.03516L18.5859 4.95703L12 11.543L5.41406 4.95703Z"
                          fill="#7A7A7A" />
                </svg>
            </button>
            <!-- Modal body -->
            <div class="grid gap-6 px-[20px] py-8">
                <div class="text-[#333] font-semibold pb-[11px] border-b border-[#eeeeee]">@CRS.ADMIN.APPLICATION.Resources.Resource.Confirmation</div>
                <div class="grid gap-[20px] text-[#062937] mb-[45px]">
                    <div class="text-[14px] text-secondary-text-2 text-start" id="confirmationRequestMessage">
                        エディターピックを削除しますか？
                    </div>
                </div>
                <div class="flex justify-end">
                    <div class="flex gap-2 justify-end mt-[45px]">
                        <input id="request_ids" value="" hidden />
                        <div class="btn btn-secondary w-[110px]" id="approve_ids1" data-modal-hide="delete-editor-pick-confirmation1">@CRS.ADMIN.APPLICATION.Resources.Resource.clubNo</div>
                        <div class="btn btn-primary w-[110px]" onclick="DeleteEditorPickerFunction()" data-vals1="" data-vals2="" data-vals3="" id="approve_ids1">@CRS.ADMIN.APPLICATION.Resources.Resource.clubYes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_ManageEditorPick", _manageRecommendation)


@section scripts{

    <script>
    $(document).ready(function () {
        $('select').select2({
            minimumResultsForSearch: Infinity
        })
             $('#large1[name="NewDiscountCategoryDDL"]').select2({
                 width: 'resolve'
             });
             $('#large1[name="ClubDDLList"]').select2({
                 width: 'resolve'
             });
             $('#large1[name="LocationDDL1"]').select2({
                 width: 'resolve'
             });
             var RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

            $('.LocationDDL1').change(function () {
                if ($(this).val() !== "") {
                    $(".ClubDDLList").prop("disabled", false);
                } else {
                    $(".ClubDDLList")
                        .prop("disabled", true)
                        .val("")
                        .trigger("change");
                }


                 $(".ClubDDLList").empty().prepend("<option value='' disabled selected>@CRS.ADMIN.APPLICATION.Resources.Resource.Select_Club</option>");
                 var locationId = document.getElementsByName("LocationDDL1")[0].value;
                 var agentId = document.getElementsByName("ClubDDLList")[0].value;
               if (!Boolean(locationId)) {
                       toastr.info('Location is required');
                   return false;
               }
               $.ajax({
                    type: 'POST',
                    async: true,
                    url: '@Url.Action("GetClubListByLocation")',
                    dataType: 'json',
                   data: { '__RequestVerificationToken': RequestVerificationToken, locationId ,agentId },
                   success: function (data) {
                       $.each(data.clubLists, function (i, ClubDDLList) {
                           $(".ClubDDLList").append('<option value="' + ClubDDLList.Value + '">' + ClubDDLList.Text + '</option>');
                        });

                    },
                    error: function (ex) {
                       toastr.info('Failed to retrive club.');
                    }
                });
                return false;
             });



        var PopUpRenderValue = '@ViewBag.PopUpRenderValue';
        var PopUpClubManageValue = '@ViewBag.PopUpClubManageValue';
        if (PopUpRenderValue != null && PopUpRenderValue != "" && PopUpRenderValue == "ManageEditorPick") {
              var element = document.getElementById('add-manage-editor-page');
                element.classList.remove('translate-x-full');
              }
          //else if (PopUpClubManageValue == "ManageClubPlan") {
          //    element1 = document.getElementById('add-manage-club-own-plan');
          //    element1.classList.remove('translate-x-full');
          //}
              let tabValue = "@ViewBag.TabValue" ?? "";
              if (tabValue === "02") {
                  const link1 = document.getElementById('tabMainLink');
                  const link2 = document.getElementById('tabEditorLink');
                  link1.style.color = '';
                  link1.style.borderBottom = '';
                  link2.style.color = '#D75A8B';
                  link2.style.borderBottom = '#D75A8B 2px solid';
                  document.getElementById('request1').style.display = 'block';
                  document.getElementById('all').style.display = 'none';

              }
              else {
                  const link1 = document.getElementById('tabMainLink');
                  const link2 = document.getElementById('tabEditorLink');
                  link1.style.color = '#D75A8B';
                  link1.style.borderBottom = '#D75A8B 2px solid';
                  link2.style.color = '';
                  link2.style.borderBottom = '';
                  document.getElementById('request1').style.display = 'none';
                  document.getElementById('all').style.display = 'block';

              }
      });
    </script>
    <script>
     document.addEventListener('DOMContentLoaded', function () {
             const page_size = @ViewBag.PageSize;
             const total_data = @ViewBag.TotalData;
             const start_index_val = @ViewBag.StartIndex;
         let URL = "/RecommendationManagementV2/Index?TabValue=02";
            let search_filter = $('#default-search-plan_list').val();
             URL = addQueryParam(URL, 'SearchFilter', search_filter);
             LoadPagination(page_size, total_data, start_index_val, URL);
         });
    </script>

    <script>

        document.getElementById('tabMainLink').style.color = '#D75A8B';
        document.getElementById('tabMainLink').style.borderBottom = '#D75A8B 2px solid';

        function changeTabV1(selectedTabId, selectedLinkId) {
            const tabLinks = document.querySelectorAll('.styleCss');
            const tabContents = document.querySelectorAll('.pane');
            tabLinks.forEach(link => {
                if (link.id === selectedLinkId) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            tabContents.forEach(content => {
                if (content.id === selectedTabId) {
                    content.style.display = 'block';
                } else {
                    content.style.display = 'none';
                }
            });
            if (selectedLinkId === 'tabMainLink') {
                const link1 = document.getElementById('tabMainLink');
                const link2 = document.getElementById('tabEditorLink');
                link1.style.color = '#D75A8B';
                link1.style.borderBottom = '#D75A8B 2px solid';
                link2.style.color = '';
                link2.style.borderBottom = '';
                let URL2 = "/RecommendationManagementV2/Index";
                let search_filter2 = $('#default-search-plan_list').val();
                URL = addQueryParam3(URL2, 'TabValue', '', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
            else if (selectedLinkId === 'tabEditorLink') {
                const link1 = document.getElementById('tabMainLink');
                const link2 = document.getElementById('tabEditorLink');
                link1.style.color = '';
                link1.style.borderBottom = '';
                link2.style.color = '#D75A8B';
                link2.style.borderBottom = '#D75A8B 2px solid';
                let URL2 = "/RecommendationManagementV2/Index";
                let search_filter2 = $('#default-search-plan-request').val();
                URL = addQueryParam3(URL2, 'TabValue', '02', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
        }
        function addQueryParam3(url, paramName, paramValue, paramName2, paramValue2) {
            if (paramValue != null && paramValue != "") {
                url += url.includes('?') ? `&${paramName}=${paramValue}` : `?${paramName}=${paramValue}`;
            }
            if (paramValue2 != null && paramValue2 != "") {
                url += url.includes('?') ? `&${paramName2}=${paramValue2}` : `?${paramName2}=${paramValue2}`;
            }

            return url;
        }

    function DeletePickerFunction(id, status) {
        const $modal = $("#delete-editor-pick-confirmation1");
        const $message = $("#confirmationRequestMessage");
        const $approveBtn = $("#approve_ids1");
        const contentApprove = "エディターピックを削除しますか？";
        $message.text(contentApprove);
        $approveBtn.attr({
            "data-vals1": id
    });
        $modal.removeClass("hidden").attr("aria-hidden", "false");
    }

    function DeleteEditorPickerFunction() {
        const id = $('#approve_ids1').attr('data-vals1');
        let search_filter2 = $('#default-search-plan-request').val();
        const start_index_val2 = @ViewBag.StartIndex;
        const page_size2 = @ViewBag.PageSize;
        window.location.href = '/RecommendationManagementV2/DeleteEditorPickDetail'
            + '?editorpickid=' + id
            + '&SearchFilter=' + search_filter2
            + '&StartIndex=' + start_index_val2
            + '&PageSize=' + page_size2;
        }


        document.getElementById('CancelEditorId').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });
        document.getElementById('CloseEditorId').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });
    </script>



}

