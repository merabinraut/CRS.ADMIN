                                                                                <i class="las la-window-close text-[24px] text-[#CB3F3F] cursor-pointer " data-modal-target="popup-modal-reject" data-modal-toggle="popup-modal-reject" alt="" onclick="rejectReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')"></i>
                                                                                <img src="/Content/assets_new/images/check-square.svg"
                                                                                     data-modal-target="popup-modal-accept"
                                                                                     data-modal-toggle="popup-modal-accept" alt="" class="cursor-pointer" onclick="acceptReq('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')">

                                                                            }
                                                                        }
                                                                        else
                                                                        {
