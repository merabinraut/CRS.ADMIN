                                                                    <div class="approved">
                                                                        @approved
                                                                    </div>
                                                                }
                                                                else if (!string.IsNullOrEmpty(item.Status) && item.Status.Trim().ToUpper() == "PENDING")
                                                                {
                                                                    <div class="pending">
                                                                        @pending
                                                                    </div>
                                                                }
                                                                else
                                                                {
