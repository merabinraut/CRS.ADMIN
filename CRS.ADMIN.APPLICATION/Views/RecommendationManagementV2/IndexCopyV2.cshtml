                                                                                         data-modal-target="popup-modal-accept"
                                                                                         data-modal-toggle="popup-modal-accept" alt="" class="cursor-pointer" onclick="acceptMainPage('@item.RecommendationHoldId','@item.ClubId','@item.DisplayId','@item.LocationId')">*@
                                                                            }

                                                                        }
