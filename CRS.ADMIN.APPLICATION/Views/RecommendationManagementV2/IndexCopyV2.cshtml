    <script>
        debugger;
        document.getElementById('tab1Link').style.color = '#D75A8B';
        document.getElementById('tab1Link').style.borderBottom = '#D75A8B 2px solid';

        function changeTabV1(selectedTabId, selectedLinkId) {
            const tabLinks = document.querySelectorAll('.styleCss');
            const tabContents = document.querySelectorAll('.pane');

            // Remove active styles from links, add to the one clicked
            tabLinks.forEach(link => {
                if (link.id === selectedLinkId) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            // Hide all tab contents, show selected
            tabContents.forEach(content => {
                if (content.id === selectedTabId) {
                    content.style.display = 'block';
                } else {
                    content.style.display = 'none';
                }
            });
            // Apply the visual style (color + border) for the selected link and reset others
            if (selectedLinkId === 'tab1Link') {
                const link1 = document.getElementById('tab1Link');
                const link2 = document.getElementById('tab2Link');
                link1.style.color = '#D75A8B';
                link1.style.borderBottom = '#D75A8B 2px solid';
                link2.style.color = '';
                link2.style.borderBottom = '';
                let URL2 = "/RecommendationManagementV2/IndexCopy";
                let search_filter2 = $('#default-search-plan_list').val();
                URL = addQueryParam3(URL2, 'TabValue', '', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
            else if (selectedLinkId === 'tab2Link') {
                const link1 = document.getElementById('tab1Link');
                const link2 = document.getElementById('tab2Link');
                link1.style.color = '';
                link1.style.borderBottom = '';
                link2.style.color = '#D75A8B';
                link2.style.borderBottom = '#D75A8B 2px solid';
                let URL2 = "/RecommendationManagementV2/IndexCopy";
                let search_filter2 = $('#default-search-plan-request').val();
                URL = addQueryParam3(URL2, 'TabValue', '02', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
        }
        function addQueryParam3(url, paramName, paramValue, paramName2, paramValue2) {
            if (paramValue != null && paramValue != "") {
                url += url.includes('?') ? `&${paramName}=${paramValue}` : `?${paramName}=${paramValue}`;
            }
            if (paramValue2 != null && paramValue2 != "") {
                url += url.includes('?') ? `&${paramName2}=${paramValue2}` : `?${paramName2}=${paramValue2}`;
            }

            return url;
        }
    </script>


















