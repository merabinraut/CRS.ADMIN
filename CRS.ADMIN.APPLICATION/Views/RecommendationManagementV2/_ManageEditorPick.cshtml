@model CRS.ADMIN.APPLICATION.Models.RecommendationManagementV2.AddEditorPick

@*@{
        var locationItems = ViewBag.LocationDDL as IEnumerable<System.Web.Mvc.SelectListItem> ?? System.Linq.Enumerable.Empty<System.Web.Mvc.SelectListItem>();
        var storeItems = ViewBag.StoreDDL as IEnumerable<System.Web.Mvc.SelectListItem> ?? System.Linq.Enumerable.Empty<System.Web.Mvc.SelectListItem>();
    }*@
<style>
    .tag-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .tag-item {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        background: #EFF6FF;
        border: 1px solid #DBEAFE;
        color: #2563EB;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all .2s ease;
        user-select: none;
    }

        .tag-item:hover {
            background: #DBEAFE;
            color: #1D4ED8;
        }

        .tag-item.active {
            background: #DBEAFE;
            border-color: #93C5FD;
            color: #1D4ED8;
        }
</style>
<div id="add-manage-editor-page"
     class="drawer-close-disable  flex justify-end fixed top-0 right-0 z-40 h-screen overflow-y-auto transition-transform translate-x-full "
     tabindex="-1" aria-labelledby="drawer-right-label">
    <div class="bg-white w-[616px] drawer-container relative">
        <div class="drawer-form-container sticky top-0 z-[5] ">
            <div class="drawer-form flex justify-between bg-secondary-color-pink py-[16px] px-[24px] h-[56px]">
                <div>
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Manage_Editor
                </div>
                <button type="button" data-drawer-hide="add-manage-editor-page" aria-controls="add-manage-editor-page"
                        class="text-[20px]" id="CloseEditorId">
                    <i class="las la-window-close text-white"></i>
                </button>
            </div>
        </div>
        @using (Html.BeginForm("ManageRecommendationV2", "RecommendationManagementV2", FormMethod.Post, new { @id = "ManageRecommendation", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="p-[24px]">
                <div class=" py-4 grid gap-5">
                    @{
                        bool isEditMode = !string.IsNullOrWhiteSpace(Model.EditorPickId?.ToString());
                    }

                    <input type="hidden" name="EditorPickId" id="EditorPickId" value="@Model.EditorPickId" />

                    <div class="input-field-common">
                        <label class="block mb-[12px] text-sm font-medium text-secondary-text-2">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Location <span class="text-red-500">*</span>
                        </label>

                        <select id="large1"
                                name="LocationDDL1"
                                class="default_select select-common block w-full LocationDDL1"
                                style="width:100%;"
                                @(isEditMode ? "disabled" : "")>
                            @{
                                var selectedLocation = Model.LocationDDL1 as string;
                            }

                            @foreach (var location in ViewBag.LocationList as IEnumerable<SelectListItem>)
                            {
                                <option value="@location.Value"
                                        @(location.Value == selectedLocation ? "selected" : null)>
                                    @location.Text
                                </option>
                            }
                        </select>

                        <span class="error"></span>
                    </div>

                    <div class="input-field-common">
                        <label class="block mb-[12px] text-sm font-medium text-secondary-text-2">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Club <span class="text-red-500">*</span>
                        </label>    
                        <select id="large2"
                                name="ClubDDLList"
                                class="default_select select-common block w-full ClubDDLList"
                                style="width:100%;"
                                @((isEditMode || string.IsNullOrEmpty(Model.LocationDDL1)) ? "disabled" : "")>

                            <option value="">@CRS.ADMIN.APPLICATION.Resources.Resource.Select_Club</option>

                            @{
                                var selectedClub = Model.ClubDDLList as string;
                            }

                            @if (ViewBag.ClubList != null)
                            {
                                foreach (var club in (IEnumerable<SelectListItem>)ViewBag.ClubList)
                                {
                                    <option value="@club.Value"
                                            @(club.Value == selectedClub ? "selected" : null)>
                                        @club.Text
                                    </option>
                                }
                            }
                        </select>
                        <span class="error"></span>
                    </div>

                    <div class="input-field-common">
                        <label class="block mb-[12px] text-sm font-medium text-secondary-100 ">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Reason_Recommendation <span class="text-red-500">*</span>
                        </label>
                        @Html.TextBoxFor(model => model.reasonForRecommendation, new { @class = "w-full rounded-[4px]", @placeholder = @CRS.ADMIN.APPLICATION.Resources.Resource.Reason_Recommendation, @style = "border-radius:4px !important", @onkeypress = "return isAlphabetWithSpace(event)", autocomplete = "off", @maxLength = "50" })
                        <span class="error">
                            @Html.ValidationMessageFor(m => m.reasonForRecommendation)
                        </span>
                    </div>

                    <div class="input-field-common">
                        <label class="block mb-[12px] text-sm font-medium text-secondary-100">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Free_Tag <span class="text-red-500">*</span>
                        </label>

                        @Html.TextBoxFor(model => model.freeTextTag,
                            new
                            {
                                @class = "w-full rounded-[4px]",
                                @placeholder = @CRS.ADMIN.APPLICATION.Resources.Resource.Free_Tag,
                                @style = "border-radius:4px !important",
                                autocomplete = "off",
                                @maxlength = "50",
                                id = "freeTextTag"
                            })

                        <span class="error">
                            @Html.ValidationMessageFor(m => m.freeTextTag)
                        </span>

                        <!-- Suggested Tags -->
                        <div class="tag-container mt-3">
                            <span class="tag-item">大箱</span>
                            <span class="tag-item">在籍多い</span>
                            <span class="tag-item">口コミ多数</span>
                            <span class="tag-item">予約殺到中</span>
                            <span class="tag-item">明朗会計</span>
                            <span class="tag-item">初回案内が丁寧</span>
                        </div>
                    </div>
                    <div class="flex justify-end ">
                        <div class="flex gap-6">
                            <button class="resetForm btn btn-primary-normal rounded-[4px] px-8 text-sm"
                                    data-drawer-hide="add-manage-editor-page" id="CancelEditorId" type="button">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.Cancel
                            </button>
                            <button class="resetForm btn btn-primary-default px-8 rounded-[4px]  text-sm leading-[10px]"
                                    id="saveData" type="submit">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.Submit
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<script>

    $(document).on("input", "#freeTextTag", function () {

        var value = $(this).val();
        var chars = Array.from(value);

        if (chars.length > 50) {
            $(this).val(chars.slice(0, 50).join(""));
        }

    });


    $("#ManageRecommendation").on("submit", function (e) {
        var location = $(".LocationDDL1").val();
        var club = $(".ClubDDLList").val();
        var isValid = true;
        if (!location || location.trim() === "") {
            $(".LocationDDL1").closest(".input-field-common").find(".error").text("Location is required.");
            isValid = false;
        } else {
            $(".LocationDDL1").closest(".input-field-common").find(".error").text("");
        }
        if (!club || club.trim() === "") {
            $(".ClubDDLList").closest(".input-field-common").find(".error").text("Club is required.");
            isValid = false;
        } else {
            $(".ClubDDLList").closest(".input-field-common").find(".error").text("");
        }
        if (!isValid) {
            e.preventDefault();
            return false;
        }
    });

    $(document).on("click", ".tag-item", function () {
        var tag = $(this).text().trim();
        if (tag.length > 20) {
            return;
        }

        var textbox = $("#freeTextTag");
        var value = textbox.val().replace(/[,\s]+$/, "");

        var tags = value === ""
            ? []
            : value.split(",").map(x => x.trim()).filter(x => x !== "");

        if (tags.length >= 4) {
            return;
        }
        if (!tags.includes(tag)) {
            tags.push(tag);
            textbox.val(tags.join(", ") + ", ");
        }
        textbox.focus();
    });

    $("#freeTextTag").on("keydown", function (e) {

        let textbox = $(this);
        let value = textbox.val();

        let tags = value
            .split(",")
            .map(x => x.trim())
            .filter(x => x !== "");

        let currentTag = value.split(",").pop().trim();
        const allowedKeys = [
            "Backspace",
            "Delete",
            "ArrowLeft",
            "ArrowRight",
            "ArrowUp",
            "ArrowDown",
            "Tab",
            "Home",
            "End"
        ];

        if (
            tags.length >= 4 &&
            currentTag === "" &&
            e.key.length === 1 &&
            !allowedKeys.includes(e.key)
        ) {
            e.preventDefault();
            return;
        }
        if (
            e.key.length === 1 &&
            e.key !== "," &&
            currentTag.length >= 20
        ) {
            e.preventDefault();
            return;
        }
        if (e.key === "Enter") {
            e.preventDefault();

            if (tags.length > 4) {
                tags = tags.slice(0, 4);
            }

            textbox.val(tags.join(", ") + (tags.length ? ", " : ""));
        }

        // Prevent creating more than 4 tags
        if (e.key === ",") {

            if (tags.length >= 4) {
                e.preventDefault();
                return;
            }

            if (currentTag.length === 0) {
                e.preventDefault();
                return;
            }
        }
    });
</script>

<script>
    $(document).on("change", ".LocationDDL1, .ClubDDLList", function () {
        var value = $(this).val();
        if (value && value.trim() !== "") {
            $(this).closest(".input-field-common").find(".error").text("");
        }
    });
</script>