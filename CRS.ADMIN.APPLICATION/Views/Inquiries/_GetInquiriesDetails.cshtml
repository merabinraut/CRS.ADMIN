
@model CRS.ADMIN.APPLICATION.Models.Inquiries.InquiriesModel
<div id="get-enqueries-details" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 botttom-0 z-50 w-full bg-[rgba(0,0,0,0.5)]
 p-4 overflow-x-hidden overflow-y-auto
 md:inset-0  " style="align-items: center;">
    <div class="relative max-w-2xl mx-auto max-h-full w-[412px] px-4 pt-[40px] pb-[46px] mt-24">
        <div class="relative bg-white rounded-lg shadow">
            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center absolute top-[24px] right-[20px] "
                    data-modal-hide="get-enqueries-details" id="CloseId_12">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
                    <rect y="0.621094" width="24" height="24" rx="12" fill="#FAFAFA" />
                    <path d="M5.41406 4.95703L4.33594 6.03516L10.9219 12.6211L4.33594 19.207L5.41406 20.2852L12 13.6992L18.5859 20.2852L19.6641 19.207L13.0781 12.6211L19.6641 6.03516L18.5859 4.95703L12 11.543L5.41406 4.95703Z"
                          fill="#7A7A7A" />
                </svg>
            </button>
            <div class="grid gap-6 px-[20px] py-8">
                <div class="text-[#333] font-semibold pb-[11px] border-b border-[#eeeeee]">View Inquiry Details</div>
                <div class="grid gap-[20px] text-[#062937] mb-[45px]">
                    <div class="text-[14px] text-secondary-text-2 text-start grid grid-cols-1 gap-[10px] modal-body" id="confirmationRequestMessage1">
                        <div class="flex">
                            <div class="w-[128px]"> Inquiry ID : </div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.InquiryId))
                                {
                                    @Model.InquiryId
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Full Name : </div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.FullName))
                                {
                                    @Model.FullName
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Email Address :</div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.EmailAddress))
                                {
                                    @Model.EmailAddress
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Phone Number :</div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    @Model.PhoneNumber
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Inquiry Type :</div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.InquiryType))
                                {
                                    @Model.InquiryType
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Subject :</div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.Subject))
                                {
                                    @Model.Subject
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex">
                            <div class="w-[128px]"> Message :</div>
                            <div class="flex-1">
                                @if (Model != null && !string.IsNullOrEmpty(Model.Message))
                                {
                                    @Model.Message
                                }
                                else
                                {
                                    @:N/A
                                }
                            </div>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="w-[128px]">Attachment :</div>

                            <a href="@Model.Attachments" target="_blank" class="text-blue-500 hover:underline">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1.25 3.125V16.875H18.75V3.125H1.25ZM2.5 4.375H17.5V13.0664L14.1992 9.74609L13.75 9.29688L10.918 12.1289L7.32422 8.49609L6.875 8.04688L2.5 12.4219V4.375ZM15 5.625C14.3091 5.625 13.75 6.18408 13.75 6.875C13.75 7.56592 14.3091 8.125 15 8.125C15.6909 8.125 16.25 7.56592 16.25 6.875C16.25 6.18408 15.6909 5.625 15 5.625ZM6.875 9.82422L12.6172 15.625H2.5V14.1992L6.875 9.82422ZM13.75 11.0742L17.5 14.8242V15.625H14.3945L11.7969 13.0078L13.75 11.0742Z" fill="#A1A1AA" />
                                </svg>
                                View
                            </a>

                            <a href="@Url.Content(@Model.Attachments)" download="@Path.GetFileName(@Model.Attachments)" class="text-blue-500 hover:underline">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M1.25 3.125V16.875H18.75V3.125H1.25ZM2.5 4.375H17.5V13.0664L14.1992 9.74609L13.75 9.29688L10.918 12.1289L7.32422 8.49609L6.875 8.04688L2.5 12.4219V4.375ZM15 5.625C14.3091 5.625 13.75 6.18408 13.75 6.875C13.75 7.56592 14.3091 8.125 15 8.125C15.6909 8.125 16.25 7.56592 16.25 6.875C16.25 6.18408 15.6909 5.625 15 5.625ZM6.875 9.82422L12.6172 15.625H2.5V14.1992L6.875 9.82422ZM13.75 11.0742L17.5 14.8242V15.625H14.3945L11.7969 13.0078L13.75 11.0742Z" fill="#A1A1AA" />
                                </svg>
                                Download
                            </a>
                        </div>

                    </div>
                </div>
                <div class="flex justify-end">
                    <div class="flex gap-2 justify-end mt-[45px]">
                        <input id="request_ids" value="" hidden />
                        <div class="btn btn-secondary w-[110px]" id="CloseId_11" data-modal-hide="get-enqueries-details">Cancel</div>
                        <a href="mailto:@Model.EmailAddress">
                            <div class="btn btn-primary w-[110px]" data-vals1="" data-vals2="" data-vals3="" id="approve_ids1">Reply</div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('CloseId_11').addEventListener('click',
        function (event) {
            event.preventDefault();
            window.location.reload();
        });
    document.getElementById('CloseId_12').addEventListener('click',
        function (event) {
            event.preventDefault();
            window.location.reload();
        });
</script>
