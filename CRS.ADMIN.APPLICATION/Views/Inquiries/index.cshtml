@model CRS.ADMIN.APPLICATION.Models.Inquiries.InquiryListModel
@{
    var tempData = TempData["ListModel"] as List<CRS.ADMIN.APPLICATION.Models.Inquiries.InquiryListModel>;
    var detailModel = TempData["DetailsModel"] as CRS.ADMIN.APPLICATION.Models.Inquiries.InquiriesModel;
}
<div class="px-8 py-4">

    <div class="flex flex-col  gap-6">

        <div>
            <div class="heading-title">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Inquiries
            </div>
            <div class="span-title-light-gray">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Manage_the_inquiries_that_has_been_made_by_customers
            </div>
        </div>

        <div class="flex justify-between pb-[24px]">
            <form action="/Inquiries/index" method="get">


                <div class="relative input-search-wrapper">
                    <div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                            <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                                  stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <input type="search"
                           id="default-search"
                           class="input-search block w-full "
                           placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search"
                           value=""
                           name="SearchFilter">
                </div>
            </form>         
        </div>

        @*table section*@

        <div class="table-tab">
            <div class="px-[12px] py-[16px] flex justify-between entry-export-container">
                <div class="flex items-center select-entries" id="ShowEntries-Id">
                </div>
            </div>
            <div class="relative overflow-x-auto">
                <table class="w-full text-left club-table">
                    <thead class="club-table-thead">
                        <tr>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    S.N
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>

                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.RequestId @*inquiryId*@
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.FullNameFurigana @*fullname*@
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.EmailAddress
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.PhoneNumber
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Type @*InquiryType*@
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Message
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Posted_Date
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                            <th scope="col" class="p-[12px]">
                                <div class="flex w-max">
                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Action
                                    <div class="relative pl-[5px]">
                                        <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                        <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (tempData.Count > 0)
                            {
                                int SN = 1;
                                foreach (var item in tempData)
                                {
                                    <tr class="bg-white border-b ">
                                        <td class="p-[12px]">
                                            @SN
                                        </td>
                                        <td class="p-[12px]">
                                            @item.InquiryId
                                        </td>
                                        <td class="p-[12px]">
                                            @item.FullName
                                        </td>
                                        <td class="p-[12px]">
                                            @item.EmailAddress
                                        </td>
                                        <td class="p-[12px]">
                                            @item.PhoneNumber
                                        </td>
                                        <td class="p-[12px]">
                                            @item.InquiryType
                                        </td>
                                        <td class="p-[12px]" style="white-space: normal; word-wrap: break-word; word-break: break-word;">
                                            @item.Message
                                        </td>
                                        <td class="p-[12px]">
                                            @item.PostedDate
                                        </td>                                  
                                        <td class="p-[12px] flex items-center space-x-2">
                                            <div onclick="getEnqueryDetails('@item.InquiryId')" style="cursor: pointer;">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                    <g clip-path="url(#clip0_8763_15685)">
                                                        <path d="M12 6C5.74805 6 0.9375 11.5078 0.9375 11.5078L0.492188 12L0.9375 12.4922C0.9375 12.4922 5.32324 17.4932 11.1562 17.9531C11.4346 17.9883 11.7129 18 12 18C12.2871 18 12.5654 17.9883 12.8438 17.9531C18.6768 17.4932 23.0625 12.4922 23.0625 12.4922L23.5078 12L23.0625 11.5078C23.0625 11.5078 18.252 6 12 6ZM12 7.5C13.6523 7.5 15.1758 7.95117 16.5 8.55469C16.9775 9.3457 17.25 10.2568 17.25 11.25C17.25 13.96 15.2168 16.1865 12.5859 16.4766C12.5713 16.4795 12.5537 16.4736 12.5391 16.4766C12.3604 16.4854 12.1816 16.5 12 16.5C11.8008 16.5 11.6074 16.4883 11.4141 16.4766C8.7832 16.1865 6.75 13.96 6.75 11.25C6.75 10.2715 7.01367 9.36035 7.47656 8.57812H7.45312C8.78906 7.96289 10.3301 7.5 12 7.5ZM12 9C10.7578 9 9.75 10.0078 9.75 11.25C9.75 12.4922 10.7578 13.5 12 13.5C13.2422 13.5 14.25 12.4922 14.25 11.25C14.25 10.0078 13.2422 9 12 9ZM5.4375 9.70312C5.32031 10.207 5.25 10.7139 5.25 11.25C5.25 12.5654 5.625 13.7959 6.28125 14.8359C4.3916 13.7432 3.0791 12.4395 2.64844 12C3.00879 11.6309 4.01367 10.6523 5.4375 9.70312ZM18.5625 9.70312C19.9863 10.6523 20.9912 11.6309 21.3516 12C20.9209 12.4395 19.6084 13.7432 17.7188 14.8359C18.375 13.7959 18.75 12.5654 18.75 11.25C18.75 10.7139 18.6797 10.2012 18.5625 9.70312Z" fill="#F89336" />
                                                    </g>
                                                    <defs>
                                                        <clipPath id="clip0_8763_15685">
                                                            <rect width="24" height="24" fill="white" />
                                                        </clipPath>
                                                    </defs>
                                                </svg>
                                            </div>
                                            <a href="mailto:@item.EmailAddress">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M9.21094 3.96094L3.21094 9.96094L2.69531 10.5L3.21094 11.0391L9.21094 17.0391L10.2891 15.9609L5.57812 11.25H15.75C17.8301 11.25 19.5 12.9199 19.5 15C19.5 17.0801 17.8301 18.75 15.75 18.75V20.25C18.6416 20.25 21 17.8916 21 15C21 12.1084 18.6416 9.75 15.75 9.75H5.57812L10.2891 5.03906L9.21094 3.96094Z" fill="#808080" />
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                    SN++;
                                }
                            }
                        }
                    </tbody>
                </table>

            </div>
            <div class="pagination-club">
                <div class="show-entry" id="Entries-Id">
                </div>
                <div class="flex gap-[12px]">
                    <div class="btn btn-secondary-box-shadow" id="prev-btn">
                        @CRS.ADMIN.APPLICATION.Resources.Resource.Previous
                    </div>
                    <div class="flex gap-[12px]" id="pagination-id">
                    </div>
                    <div class="btn btn-secondary-box-shadow" id="next-btn">
                        @CRS.ADMIN.APPLICATION.Resources.Resource.Next
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    <div id="get-inquiries-details-id"></div>
</div>

@section scripts
{
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const page_size = @ViewBag.PageSize;
        const total_data = @ViewBag.TotalData;
        const start_index_val = @ViewBag.StartIndex;
        let URL = "/Inquiries/index";
        let search_filter = $('#default-search').val();
        URL = addQueryParam(URL, 'SearchFilter', search_filter);
        LoadPagination(page_size, total_data, start_index_val, URL);
    });
    </script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {
            var content = document.getElementById("long-content");
            var btn = document.querySelector(".see-more-btn1");

            //if (content.clientWidth < content.scrollWidth) {
            //    btn.style.display = "block";
            //} else {
            //    btn.style.display = "none";
            //}
        });
    </script>
    <script>
    function getEnqueryDetails(InquiryId) {
        console.log('Inquiry ID:', InquiryId);

        var modal = $('#get-enquery_details');
        modal.addClass('loading');

        $.ajax({
            url: '@Url.Action("GetInquiriesDetailsView", "Inquiries")',
            method: 'GET',
            data: { inquiryId: InquiryId },
            success: function (response) {
                debugger;
                modal.removeClass('loading');
                $('#get-inquiries-details-id').html(response);
            },
            error: function(xhr, status, error) {
                console.error('Error fetching inquiry details:', error);
                modal.removeClass('loading');
                alert('An error occurred while fetching the inquiry details.');
            }
        });
        }

        document.getElementById('ClubPlanCloseId_5').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });


    </script>

}

<style>
    .content-container {
        max-width: 500px;
    }

    .see-more-btn {
        margin-top: 10px;
        cursor: pointer;
    }
</style>
