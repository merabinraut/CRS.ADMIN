            </div>
        </div>
    </div>
</div>



@Html.Partial("_ManageDiscountSubCategoryPartialView", _subCategoryModel)

@section scripts{
    <script>
document.addEventListener('DOMContentLoaded', function () {
    const page_size = @ViewBag.PageSize;
    const total_data = @ViewBag.TotalData;
    const start_index_val = @ViewBag.StartIndex;
    let URL = "/DiscountManagement/GetCategoryDetailsList";
    let search_filter = $('#default-search-discount-sub-category-list').val();
    URL = addQueryParam(URL, 'SearchFilter', search_filter);
    LoadPagination(page_size, total_data, start_index_val, URL);
});
    </script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {
            var content = document.getElementById("long-content");
            var btn = document.querySelector(".see-more-btn1");
        });
    </script>

    <style>
        .content-container {
            max-width: 500px;
        }

        .see-more-btn {
            margin-top: 10px;
            cursor: pointer;
        }
    </style>





    <script>
        function EditDiscountSubCategory(id, j, k) {
            window.location.href = '/DiscountManagement/ManageDiscountSubCategoryDetails?categoryId=' + id + '&subCategoryId=' + j + '&categoryName=' + k;
        }
        function isNumber(event) {
            var charCode = event.which ? event.which : event.keyCode;
            var inputValue = event.target.value;

            if (charCode === 8) {
                return true;
            }

            if (charCode >= 48 && charCode <= 57 || charCode === 46) {
                if (charCode === 46) {
                    return false;
                }
                return true;
            }
            return false;
        }
    </script>
    <script>
        $(document).ready(function () {
            $('select').select2({
                minimumResultsForSearch: Infinity
            })

            var PopUpRenderValue = '@ViewBag.PopUpRenderValue';
            var PopUpClubManageValue = '@ViewBag.PopUpClubManageValue';
            if (PopUpRenderValue != null && PopUpRenderValue != "" && PopUpRenderValue == "ManageSubCategory") {
                var element = document.getElementById('add-new-discount-sub-category');
                element.classList.remove('translate-x-full');
            }

            document.getElementById('CloseId').addEventListener('click',
                function (event) {
                    event.preventDefault();
                    window.location.reload();
                });
            document.getElementById('CancelId').addEventListener('click',
                function (event) {
                    event.preventDefault();
                    window.location.reload();
                });
        });

    </script>
    <script>
        function openSubCategoryBlockEventModal(categoryId, SubCategoryId, categoryName, status) {
            const $modal = $("#block-discount-sub-category");
            const $message = $("#confirmationRequestMessage");
            const $approveBtn = $("#block_ids2");
            const contentApprove = "Are you sure you want to block this sub category ?";
            $message.text(contentApprove);
            $approveBtn.attr({
                "data-vals1": categoryId,
                "data-vals2": SubCategoryId,
                "data-vals3": categoryName,
                "data-vals4": status,
            });
            $modal.removeClass("hidden").attr("aria-hidden", "false");
        }


        function BlockDiscountSubCategoryFunction() {
        const categoryId = $('#block_ids2').attr('data-vals1');
        const SubCategoryId = $('#block_ids2').attr('data-vals2');
        const categoryName = $('#block_ids2').attr('data-vals3');
        const status = $('#block_ids2').attr('data-vals4');
        let search_filter2 = $('#default-search-plan-request').val();
        const start_index_val2 = @ViewBag.StartIndex;
        const page_size2 = @ViewBag.PageSize;
            window.location.href = '/DiscountManagement/DiscountSubCategoryStatus'
            + '?CategoryId=' + categoryId
            + '&SubCategoryId=' + SubCategoryId
            + '&CategoryName=' + categoryName
            + '&status=' + status
            + '&SearchFilter=' + search_filter2
            + '&StartIndex=' + start_index_val2
            + '&PageSize=' + page_size2;
        }


    function openSubCategoryUnBlockEventModal(categoryId, SubCategoryId, categoryName, status) {
         const $modal = $("#unblock-sub-category-confirmation");
        const $message = $("#confirmationRequestMessage");
        const $approveBtn = $("#block_ids2");
        const contentApprove = "Are you sure you want to block this sub category ?";
        $message.text(contentApprove);
        $approveBtn.attr({
            "data-vals1": categoryId,
            "data-vals2": SubCategoryId,
            "data-vals3": categoryName,
            "data-vals4": status,
        });
        $modal.removeClass("hidden").attr("aria-hidden", "false");
    }


    function UnBlockDiscountSubCategoryFunction() {
    const categoryId = $('#block_ids2').attr('data-vals1');
    const SubCategoryId = $('#block_ids2').attr('data-vals2');
    const categoryName = $('#block_ids2').attr('data-vals3');
    const status = $('#block_ids2').attr('data-vals4');
    let search_filter2 = $('#default-search-plan-request').val();
    const start_index_val2 = @ViewBag.StartIndex;
    const page_size2 = @ViewBag.PageSize;
        window.location.href = '/DiscountManagement/DiscountSubCategoryStatus'
        + '?CategoryId=' + categoryId
        + '&SubCategoryId=' + SubCategoryId
        + '&CategoryName=' + categoryName
        + '&status=' + status
        + '&SearchFilter=' + search_filter2
        + '&StartIndex=' + start_index_val2
        + '&PageSize=' + page_size2;
        }



       function deleteSubDiscountSubCategory(categoryId, SubCategoryId, categoryName, status) {
       const $modal = $("#delete-sub-category-confirmation");
        const $message = $("#confirmationRequestMessage");
           const $approveBtn = $("#delete_ids2");
        const contentApprove = "Are you sure you want to delete this slab ?";
        $message.text(contentApprove);
        $approveBtn.attr({
            "data-vals1": categoryId,
            "data-vals2": SubCategoryId,
            "data-vals3": categoryName,
            "data-vals4": status,
        });
        $modal.removeClass("hidden").attr("aria-hidden", "false");
    }


   function DeleteDiscountCategoryFunction() {
    const categoryId = $('#delete_ids2').attr('data-vals1');
        const SubCategoryId = $('#delete_ids2').attr('data-vals2');
        const categoryName = $('#delete_ids2').attr('data-vals3');
        const status = $('#delete_ids2').attr('data-vals4');
    let search_filter2 = $('#default-search-plan-request').val();
    const start_index_val2 = @ViewBag.StartIndex;
    const page_size2 = @ViewBag.PageSize;
        window.location.href = '/DiscountManagement/DiscountSubCategoryStatus'
        + '?CategoryId=' + categoryId
        + '&SubCategoryId=' + SubCategoryId
        + '&CategoryName=' + categoryName
        + '&status=' + status
        + '&SearchFilter=' + search_filter2
        + '&StartIndex=' + start_index_val2
        + '&PageSize=' + page_size2;
}

    </script>

}
