@model CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementListResponseModel
@{
    ViewBag.Title = "Plan List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _subCategoryModel = Model.discountSubCategoryModel as CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountSubCategoryManagementRequestModel;
    var tempData = TempData["ListModel"] as List<CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementListResponseModel>;
}
<div class="px-8 py-4">
    @Html.AntiForgeryToken()
    <div class="flex flex-col  gap-6">
        <div class="flex justify-between items-center">
            <div>
                <div class="heading-title">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.DiscountManagement
                </div>
                <div class="span-title-light-gray">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.ManageDiscountSetting
                </div>
            </div>
        </div>
        <div id="tab1" class="tab-content-plane ">
            <div class="flex flex-col gap-8">
                <div id="tab1" class="tab-content">
                    <div class="flex gap-4 mb-8 border-b ">
                        <div id="CategoryLink" class="styleCss px-1 pb-4 cursor-pointer active" onclick="changeCategoryTab('allCategory', 'CategoryLink')">
                            <b> @CRS.ADMIN.APPLICATION.Resources.Resource.DiscountCategory :</b>  <b>@ViewBag.DiscountCategoryName</b>
                        </div>
                    </div>
                    <div class="flex justify-between pb-[24px]">

                    </div>
                    @if (!string.IsNullOrEmpty(Convert.ToString(Model.listDiscountSubCategoryManagement)))
                    {
                        @Html.Partial("_DiscountCategoryDetailsPartialView", Model)
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div id="block-discount-sub-category" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full
     p-4 overflow-x-hidden overflow-y-auto
     md:inset-0 h-[calc(100%-1rem)] max-h-full " style="align-items: flex-start;">
    <div class="relative max-w-2xl max-h-full w-[412px] px-4 pt-[40px] pb-[46px] mt-24">
        <div class="relative bg-white rounded-lg shadow">
            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center absolute top-[24px] right-[20px] "
                    data-modal-hide="block-discount-sub-category">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="25" viewBox="0 0 24 25" fill="none">
                    <rect y="0.621094" width="24" height="24" rx="12" fill="#FAFAFA" />
                    <path d="M5.41406 4.95703L4.33594 6.03516L10.9219 12.6211L4.33594 19.207L5.41406 20.2852L12 13.6992L18.5859 20.2852L19.6641 19.207L13.0781 12.6211L19.6641 6.03516L18.5859 4.95703L12 11.543L5.41406 4.95703Z"
                          fill="#7A7A7A" />
                </svg>
            </button>
            <div class="grid gap-6 px-[20px] py-8">
                <div class="text-[#333] font-semibold pb-[11px] border-b border-[#eeeeee]">@CRS.ADMIN.APPLICATION.Resources.Resource.Confirmation</div>
                <div class="grid gap-[20px] text-[#062937] mb-[45px]">
                    <div class="text-[14px] text-secondary-text-2 text-start" id="deleteRequestMessage">
                        @*@CRS.ADMIN.APPLICATION.Resources.Resource.PlanRequestConfirmationMessage*@この割引スラブをブロックしてもよろしいですか？

                    </div>
                </div>
                <div class="flex justify-end">
                    <div class="flex gap-2 justify-end mt-[45px]">
                        <input id="request_ids" value="" hidden />
                        <div class="btn btn-secondary w-[110px]" id="block_ids2" data-modal-hide="block-discount-sub-category">@CRS.ADMIN.APPLICATION.Resources.Resource.clubNo</div>
                        <div class="btn btn-primary w-[110px]" onclick="BlockDiscountSubCategoryFunction()" data-vals1="" data-vals2="" data-vals3="" data-vals4="" id="block_ids2">@CRS.ADMIN.APPLICATION.Resources.Resource.clubYes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


