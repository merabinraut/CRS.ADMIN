@model CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementListResponseModel

<form action="/DiscountManagement/GetCategoryDetailsList" method="get">
    <div class="relative input-search-wrapper flex justify-between">
        <div class="absolute inset-y-0 left-0 flex items-center pl-[16px] pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
                <path d="M17.5 18L13.875 14.375M15.8333 9.66667C15.8333 13.3486 12.8486 16.3333 9.16667 16.3333C5.48477 16.3333 2.5 13.3486 2.5 9.66667C2.5 5.98477 5.48477 3 9.16667 3C12.8486 3 15.8333 5.98477 15.8333 9.66667Z"
                      stroke="#667085" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>

        <input type="search"
               id="default-search-discount-sub-category-list"
               class="input-search block w-full "
               placeholder="@CRS.ADMIN.APPLICATION.Resources.Resource.Search"
               value="@ViewBag.SearchFilter"
               name="SearchFilter">
        <div class="flex gap-6 bg-blue">
            <div class="btn btn-primary gap-[8px] h-[40px]" data-drawer-target="add-new-discount-sub-category"
                 data-drawer-show="add-new-discount-sub-category" data-drawer-placement="right" data-drawer-backdrop="false"
                 aria-controls="drawer-disabled-backdrop">
                <img src="~/Content/assets_new/images/plus-circle-solid.svg" />
                @CRS.ADMIN.APPLICATION.Resources.Resource.Add_New
            </div>
        </div>

    </div>
</form>
<div class="flex gap-6">

</div>
<div class="table-tab" id="all">
    <div class="px-[16px] py-[12px] flex justify-between entry-export-container">
        <div class="flex items-center select-entries" id="ShowEntries-Id">
        </div>
    </div>
    <div class="relative overflow-x-auto">
        <table class="w-full text-left club-table" id="table-id">
            <thead class="club-table-thead">
                <tr>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            S.N
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>

                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.FromAmount
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.ToAmount
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.DiscountType @*DiscountType*@
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Value
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Min_Value
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Max_Value
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Status
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.CreatedDate
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.UpdatedDate
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                    <th scope="col" class="p-[12px]">
                        <div class="flex w-max">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Action
                            <div class="relative pl-[5px]">
                                <i class="fa-solid fa-chevron-up text-[8px] absolute top-[2px] text-[#545659]"></i>
                                <i class="fa-solid fa-chevron-down text-[8px] absolute top-[8px] let-[5px] text-[#c3b6b9]"></i>
                            </div>
                        </div>
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach (var item in Model.listDiscountSubCategoryManagement)
                    {

                        <tr class="bg-white border-b ">
                            <td class="p-[12px]">
                                @item.SNO
                            </td>
                            <td class="p-[12px]">
                                @item.FromAmount.ToString("N0")
                            </td>
                            <td class="p-[12px]">
                                @item.ToAmount.ToString("N0")
                            </td>
                            <td class="p-[12px]">
                                @if (!string.IsNullOrEmpty(item.Status) && item.DiscountType.ToUpper().Trim() == "FLAT")
                                {
                                    <div class="w-max  plan-platinum gap-2">
                                        FLAT
                                    </div>
                                }
                                else
                                {
                                    <div class="w-max plan-b  gap-2">
                                        PERCENTAGE
                                    </div>
                                }                            
                            </td>
                            <td class="p-[12px]">
                                @item.Value
                            </td>
                            <td class="p-[12px]">
                                @item.MinValue.ToString("N0")
                            </td>
                            <td class="p-[12px]">
                                @item.MaxValue.ToString("N0")
                            </td>
                            <td class="p-[12px]">
                                @if (!string.IsNullOrEmpty(item.Status) && item.Status.ToUpper().Trim() == "A")
                                {
                                    <div class="approved">
                                        ACTIVE
                                    </div>
                                }
                                else
                                {
                                    <div class="rejected">
                                        SUSPENDED
                                    </div>
                                }
                            </td>
                            <td class="p-[12px]">
                                <div class="">
                                    @item.createdDate
                                </div>
                            </td>

                            <td class="p-[12px]">
                                @item.updatedDate
                            </td>
                            <td class="p-[12px]">
                                <div class="flex gap-[7px] justify-center text-[16px] ">

                                    @if (item.Status.ToUpper() == "A")
                                    {
                                        <div>
                                            <i class="fa-regular fa-pen-to-square text-[#989898] cursor-pointer" onclick="EditDiscountSubCategory('@item.CategoryId','@item.SubCategoryId','@item.categoryName')"></i>
                                        </div>
                                        <div>
                                            <div onclick="deleteSubDiscountSubCategory('@item.CategoryId','@item.SubCategoryId','@item.categoryName','D')" data-modal-target="delete-sub-category-confirmation" data-modal-toggle="delete-sub-category-confirmation">
                                                <i class="fa-solid fa-trash-can text-primary-100 cursor-pointer"></i>
                                            </div>
                                        </div>
                                        <div onclick="openSubCategoryBlockEventModal('@item.CategoryId','@item.SubCategoryId','@item.categoryName','B')" data-modal-target="block-discount-sub-category" data-modal-toggle="block-discount-sub-category">
                                            <i class="fa-solid fa-lock text-primary-100 cursor-pointer"></i>
                                        </div>
                                    }
                                    @if (item.Status.ToUpper() == "B")
                                    {
                                    <div onclick="openSubCategoryUnBlockEventModal('@item.CategoryId','@item.SubCategoryId','@item.categoryName','A')" data-modal-target="unblock-sub-category-confirmation" data-modal-toggle="unblock-sub-category-confirmation">
                                        <i class="fa-solid fa-unlock text-primary-100 cursor-pointer"></i>
                                    </div>
                                    }


                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="pagination-club">
        <div class="show-entry" id="Entries-Id">
        </div>
        <div class="flex gap-[12px]">
            <div class="btn btn-secondary-box-shadow" id="prev-btn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Previous
            </div>
            <div class="flex gap-[12px]" id="pagination-id">
            </div>
            <div class="btn btn-secondary-box-shadow" id="next-btn">
                @CRS.ADMIN.APPLICATION.Resources.Resource.Next
            </div>
        </div>
    </div>
</div>
