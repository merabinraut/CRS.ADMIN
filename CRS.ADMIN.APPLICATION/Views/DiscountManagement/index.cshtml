@section scripts{
    <script>
 document.addEventListener('DOMContentLoaded', function () {
     const page_size = @ViewBag.PageSize;
     const total_data = @ViewBag.TotalData;
     const start_index_val = @ViewBag.StartIndex;
     let URL = "/DiscountManagement/GetCategoryDetailsList";
     let search_filter = $('#default-search-discount-category-list').val();
     URL = addQueryParam(URL, 'SearchFilter', search_filter);
     LoadPagination(page_size, total_data, start_index_val, URL);
 });
    </script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {
            var content = document.getElementById("long-content");
            var btn = document.querySelector(".see-more-btn1");
        });
    </script>

    <style>
        .content-container {
            max-width: 500px;
        }

        .see-more-btn {
            margin-top: 10px;
            cursor: pointer;
        }
    </style>

    <script>
          $(document).ready(function () {
          $('select').select2({
              minimumResultsForSearch: Infinity
          })
              $('#large1[name="NewDiscountCategoryDDL"]').select2({
                  width: 'resolve'
              });
              $('#large1[name="ClubDDLList"]').select2({
                  width: 'resolve'
              });
              $('#large1[name="LocationDDL1"]').select2({
                  width: 'resolve'
              });
              var RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();

              $('.LocationDDL1').change(function () {
                   $(".ClubDDLList").empty().prepend("<option value='' disabled selected>@CRS.ADMIN.APPLICATION.Resources.Resource.Select_Club</option>");
                  var locationId = document.getElementsByName("LocationDDL1")[0].value;
                  var agentId = document.getElementsByName("ClubDDLList")[0].value;
                if (!Boolean(locationId)) {
                        toastr.info('Location is required');
                    return false;
                }
                $.ajax({
                     type: 'POST',
                     async: true,
                     url: '@Url.Action("GetDiscountClubListByLocation")',
                     dataType: 'json',
                    data: { '__RequestVerificationToken': RequestVerificationToken, locationId ,agentId },
                    success: function (data) {
                        $.each(data.clubLists, function (i, ClubDDLList) {
                            $(".ClubDDLList").append('<option value="' + ClubDDLList.Value + '">' + ClubDDLList.Text + '</option>');
                         });

                     },
                     error: function (ex) {
                        toastr.info('Failed to retrive club.');
                     }
                 });
                 return false;
              });

           $('.ClubDDLList').change(function () {
               var agentId = document.getElementsByName("ClubDDLList")[0].value;
            $.ajax({
                type: 'POST',
                async: true,
                url: '@Url.Action("GetCurrentDiscountByClub")',
                dataType: 'json',
                data: { '__RequestVerificationToken': RequestVerificationToken, agentId },
                success: function (data)
                {
                   var currentDiscountDDL = $(".CurrentDiscountCategoryDDL");
                   currentDiscountDDL.empty().append('<option value="" disabled selected>@CRS.ADMIN.APPLICATION.Resources.Resource.Current_Discount_Category</option>');
                   $('#DiscountCategoryName').val(data.commissionLists[0].Text);
                },
                error: function (ex) {
                    toastr.info('Failed to retrive current commission category.');
                }
            });
            return false;
            });



          var PopUpRenderValue = '@ViewBag.PopUpRenderValue';
          var PopUpClubManageValue = '@ViewBag.PopUpClubManageValue';
          if (PopUpRenderValue != null && PopUpRenderValue != "" && PopUpRenderValue == "Manage") {
              var element = document.getElementById('add-new-discount-category');
              element.classList.remove('translate-x-full');
              }
          else if (PopUpClubManageValue == "ManageAssign") {
              element1 = document.getElementById('add-manage-discount-category');
              element1.classList.remove('translate-x-full');
          }
              let tabValue = "@ViewBag.TabValue" ?? "";
              if (tabValue === "02") {
                  const link1 = document.getElementById('CategoryLink');
                  const link2 = document.getElementById('AssignLink');
                  link1.style.color = '';
                  link1.style.borderBottom = '';
                  link2.style.color = '#D75A8B';
                  link2.style.borderBottom = '#D75A8B 2px solid';
                  document.getElementById('requestAssign').style.display = 'block';
                  document.getElementById('allCategory').style.display = 'none';

              }
              else {
                  const link1 = document.getElementById('CategoryLink');
                  const link2 = document.getElementById('AssignLink');
                  link1.style.color = '#D75A8B';
                  link1.style.borderBottom = '#D75A8B 2px solid';
                  link2.style.color = '';
                  link2.style.borderBottom = '';
                  document.getElementById('requestAssign').style.display = 'none';
                  document.getElementById('allCategory').style.display = 'block';

              }
      });
      document.getElementById('CloseId').addEventListener('click',
          function (event) {
              event.preventDefault();
              window.location.reload();
          });
      document.getElementById('CancelId').addEventListener('click',
          function (event) {
              event.preventDefault();
              window.location.reload();
          });
    </script>

    <script>
        document.getElementById('CategoryLink').style.color = '#D75A8B';
        document.getElementById('CategoryLink').style.borderBottom = '#D75A8B 2px solid';

        function changeCategoryTab(selectedTabId, selectedLinkId) {
            const tabLinks = document.querySelectorAll('.styleCss');
            const tabContents = document.querySelectorAll('.pane');

            tabLinks.forEach(link => {
                if (link.id === selectedLinkId) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });

            tabContents.forEach(content => {
                if (content.id === selectedTabId) {
                    content.style.display = 'block';
                } else {
                    content.style.display = 'none';
                }
            });

            if (selectedLinkId === 'CategoryLink') {
                const link1 = document.getElementById('CategoryLink');
                const link2 = document.getElementById('AssignLink');
                link1.style.color = '#D75A8B';
                link1.style.borderBottom = '#D75A8B 2px solid';
                link2.style.color = '';
                link2.style.borderBottom = '';
                let URL2 = "/DiscountManagement/Index";
                let search_filter2 = $('#default-search-plan_list').val();
                URL = addQueryParam3(URL2, 'TabValue', '', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
            else if (selectedLinkId === 'AssignLink') {
                const link1 = document.getElementById('CategoryLink');
                const link2 = document.getElementById('AssignLink');
                link1.style.color = '';
                link1.style.borderBottom = '';
                link2.style.color = '#D75A8B';
                link2.style.borderBottom = '#D75A8B 2px solid';
                let URL2 = "/DiscountManagement/Index";
                let search_filter2 = $('#default-search-plan-request').val();
                URL = addQueryParam3(URL2, 'TabValue', '02', 'SearchFilter', search_filter2);
                window.location.href = URL
            }
        }
        function addQueryParam3(url, paramName, paramValue, paramName2, paramValue2) {
            if (paramValue != null && paramValue != "") {
                url += url.includes('?') ? `&${paramName}=${paramValue}` : `?${paramName}=${paramValue}`;
            }
            if (paramValue2 != null && paramValue2 != "") {
                url += url.includes('?') ? `&${paramName2}=${paramValue2}` : `?${paramName2}=${paramValue2}`;
            }
            return url;
        }
    </script>
    <script>
        function editDiscountCategory(id) {
            window.location.href = '/DiscountManagement/ManageDiscountCategory?categoryId=' + id;
        }
        function openCategoryBlockEventModal(categoryId, status) {
            const $modal = $("#block-discount-category");
            const $message = $("#confirmationRequestMessage");
            const $approveBtn = $("#block_ids1");
            const contentApprove = "Are you sure you want to block this category ?";
        $message.text(contentApprove);
        $approveBtn.attr({
            "data-vals1": categoryId,
            "data-vals2": status,
            });
        $modal.removeClass("hidden").attr("aria-hidden", "false");
        }

        function BlockDiscountCategoryFunction() {
            const categoryId = $('#block_ids1').attr('data-vals1');
            const status = $('#block_ids1').attr('data-vals2');
            let search_filter2 = $('#default-search-plan-request').val();
            const start_index_val2 = @ViewBag.StartIndex;
            const page_size2 = @ViewBag.PageSize;
            window.location.href = '/DiscountManagement/DiscountCategoryStatusUpdate'
                + '?CategoryId=' + categoryId
                + '&status=' + status
                + '&SearchFilter=' + search_filter2
                + '&StartIndex=' + start_index_val2
                + '&PageSize=' + page_size2;
        }

    function openCategoryUnBlockEventModal(categoryId, status) {
       const $modal = $("#unblock-discount-category");
       const $message = $("#confirmationRequestMessage");
       const $approveBtn = $("#block_ids1");
       const contentApprove = "Are you sure want to un-block this category?";
    $message.text(contentApprove);
    $approveBtn.attr({
       "data-vals1": categoryId,
       "data-vals2": status,
       });
    $modal.removeClass("hidden").attr("aria-hidden", "false");
    }

   function UnBlockDiscountCategoryFunction() {
       const categoryId = $('#block_ids1').attr('data-vals1');
       const status = $('#block_ids1').attr('data-vals2');
       let search_filter2 = $('#default-search-plan-request').val();
       const start_index_val2 = @ViewBag.StartIndex;
       const page_size2 = @ViewBag.PageSize;
       window.location.href = '/DiscountManagement/DiscountCategoryStatusUpdate'
           + '?CategoryId=' + categoryId
           + '&status=' + status
           + '&SearchFilter=' + search_filter2
           + '&StartIndex=' + start_index_val2
           + '&PageSize=' + page_size2;
        }

  function deleteDiscountCategory(categoryId, status) {
    const $modal = $("#unblock-discount-category");
    const $message = $("#confirmationRequestMessage");
      const $approveBtn = $("#delete_ids1");
    const contentApprove = "Are you sure want to un-block this category?";
    $message.text(contentApprove);
    $approveBtn.attr({
    "data-vals1": categoryId,
    "data-vals2": status,
    });
    $modal.removeClass("hidden").attr("aria-hidden", "false");
    }

function DeleteDiscountCategoryFunction() {
    const categoryId = $('#delete_ids1').attr('data-vals1');
    const status = $('#delete_ids1').attr('data-vals2');
    let search_filter2 = $('#default-search-plan-request').val();
    const start_index_val2 = @ViewBag.StartIndex;
    const page_size2 = @ViewBag.PageSize;
    window.location.href = '/DiscountManagement/DiscountCategoryStatusUpdate'
        + '?CategoryId=' + categoryId
        + '&status=' + status
        + '&SearchFilter=' + search_filter2
        + '&StartIndex=' + start_index_val2
        + '&PageSize=' + page_size2;
    }
    </script>
}
