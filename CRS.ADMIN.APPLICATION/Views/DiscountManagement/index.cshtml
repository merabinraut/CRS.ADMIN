@model CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementListResponseModel
@{
    ViewBag.Title = "Plan List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var _categoryModel = Model.discountCategoryModel as CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementModel;

    if (_categoryModel == null)
    {
        _categoryModel = new CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementModel();
    }
    var tempData = TempData["ListModel"] as List<CRS.ADMIN.APPLICATION.Models.DiscountManagement.DiscountManagementListResponseModel>;
}
<div class="px-8 py-4">
    @Html.AntiForgeryToken()
    <div class="flex flex-col  gap-6">
        <div class="flex justify-between items-center">
            <div>
                <div class="heading-title">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.DiscountManagement
                </div>
                <div class="span-title-light-gray">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.ManageDiscountSetting
                </div>
            </div>
        </div>
        <div id="tab1" class="tab-content-plane ">
            <div class="flex flex-col gap-8">
                <div id="tab1" class="tab-content">
                    <div class="flex gap-4 mb-8 border-b ">

                        <div id="CategoryLink" class="styleCss px-1 pb-4 cursor-pointer active" onclick="changeCategoryTab('allCategory', 'CategoryLink')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.DiscountCategory
                        </div>

                        <div id="AssignLink" class="styleCss px-1 pb-4 cursor-pointer" onclick="changeCategoryTab('requestAssign','AssignLink')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.AssignDiscount
                        </div>
                    </div>
                    <div class="flex justify-between pb-[24px]">

                    </div>
                    <div class="pane active table-tab" id="allCategory">
                        @if (!string.IsNullOrEmpty(Convert.ToString(Model.listDiscountManagement)))
                        {
                            @Html.Partial("_DiscountCategoryPartialView", Model)
                        }
                    </div>
                    <div class="pane" id="requestAssign" style="display: none;">
                        @using (Html.BeginForm("AssignDiscount", "DiscountManagement", new { }, FormMethod.Post, new { @id = "AssignDiscount" }))
                        {
                            @Html.AntiForgeryToken()

                            <div class="bg-white">
                                <div id="tab" class="tab-content-plane">
                                    <div class="border border-[#D0D5DD] rounded-[5px] px-[22px] py-5 flex flex-col gap-4">
                                        <div class="py-[10px] text-[#3E3E3E] text-sm font-semibold">
                                            @*@CRS.ADMIN.APPLICATION.Resources.Resource.Assign_Commission*@
                                        </div>
                                        <div class="grid grid-cols-3 gap-x-12 gap-y-4">
                                            <div class=" input-field-common">
                                                <label class="block mb-[12px] text-sm font-medium text-secondary-text-2 ">
                                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Location
                                                </label>
                                                <select id="large1" name="LocationDDL1" class=" default_select select-common block w-full LocationDDL1"
                                                        style="width: 100%;">
                                                    @foreach (var location in ViewBag.LocationList as IEnumerable<SelectListItem>)
                                                    {
                                                        <option value="@location.Value">@location.Text</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class=" input-field-common">
                                                <label class="block mb-[12px] text-sm font-medium text-secondary-text-2 ">
                                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Club
                                                </label>
                                                <select id="large1" name="ClubDDLList" class=" default_select select-common block w-full ClubDDLList"
                                                        style="width: 100%;">
                                                    <option>@CRS.ADMIN.APPLICATION.Resources.Resource.Select_Club</option>
                                                </select>
                                            </div>
                                            <div class=" input-field-common">
                                                <label class="block mb-[12px] text-sm font-medium text-secondary-text-2 ">
                                                    @CRS.ADMIN.APPLICATION.Resources.Resource.Current_Discount_Category
                                                </label>
                                                @Html.TextBoxFor(model => model.assignDiscountModel.CategoryName, new { @class = "w-full rounded-[4px]", @id = "DiscountCategoryName", @placeholder = @CRS.ADMIN.APPLICATION.Resources.Resource.Current_Discount_Category, @style = "border-radius:4px !important", @onkeypress = "return isAlphabetWithSpace(event)", autocomplete = "off", @maxLength = "50", @disabled = true })
                                            </div>
                                            <div class=" input-field-common">
                                                <label class="block mb-[12px] text-sm font-medium text-secondary-text-2 ">
                                                    @CRS.ADMIN.APPLICATION.Resources.Resource.New_Discount_Category
                                                </label>
                                                <select id="large1" name="NewDiscountCategoryDDL" class=" default_select select-common block w-full NewDiscountCategoryDDL"
                                                        style="width: 100%;">
                                                    @foreach (var location in ViewBag.CommissionCategoryList as IEnumerable<SelectListItem>)
                                                    {
                                                        <option value="@location.Value">@location.Text</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button onclick="@Url.Action("AssignDiscount", "DiscountManagement")" class="resetForm btn btn-primary-default h-[40px] px-8 rounded-[4px] w-max  text-sm leading-[10px]"
                                    data-drawer-hide="add-new-commision" data-modal-target="add-new-host-modal-save"
                                    data-modal-toggle="add-new-host-modal-save" id="btnAssignCommission">
                                @CRS.ADMIN.APPLICATION.Resources.Resource.Save
                            </button>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@Html.Partial("_ManageDiscountCategoryPartialView", _categoryModel)

<div id="delete-category-confirmation" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full
