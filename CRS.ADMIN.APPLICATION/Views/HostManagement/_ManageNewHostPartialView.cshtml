                </div>

                <div class="flex justify-end py-[16px] ">
                    <div class="flex gap-[24px]">
                        <div class="btn btn-secondary" data-drawer-hide="add-new-host" aria-controls="add-new-host" onclick="CancelFunction();">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Cancel
                        </div>
                        <div class="btn btn-primary">
                            <button type="submit">@CRS.ADMIN.APPLICATION.Resources.Resource.Submit</button>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ranges = document.querySelectorAll(".skill-range");

        ranges.forEach(function (range) {
            const updateRange = function () {
                const min = Number(range.min);
                const max = Number(range.max);
                const value = Number(range.value);
                const percent = ((value - min) / (max - min)) * 100;

                range.style.setProperty("--progress", percent + "%");

                const skillItem = range.closest(".skill-item");
                const valueText = skillItem.querySelector(".range-value strong");
                const dots = skillItem.querySelectorAll(".range-dots span");
                const hiddenInput = skillItem.querySelector(".score-hidden");


                if (valueText) {
                    valueText.textContent = value;
                    hiddenInput.value = value;
                }

                dots.forEach(function (dot, index) {
                    dot.classList.toggle("active", index < value);
                });
            };

            range.addEventListener("input", updateRange);
            updateRange();
        });
    });
</script>


<script>
    const input = document.getElementById("file_input_business_certificate");
    const fileName = document.getElementById("file_name_bussiness_certificate");
    const modal = document.getElementById("cropModal");
    const image = document.getElementById("imageToCrop");
    const cropBtn = document.getElementById("cropImageButton");
    const cancelBtn = document.getElementById("cancelCropButton");

    let cropper = null;
    let currentFile = null;

    input.addEventListener("change", function () {

        if (!input.files || !input.files[0]) return;

        const file = input.files[0];
        currentFile = file;

        if (cropper) {
            cropper.destroy();
            cropper = null;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("File must be less than 5 MB");
            input.value = "";
            fileName.textContent = "No File Choosen";
            return;
        }

        fileName.textContent = file.name;

        const reader = new FileReader();

        reader.onload = function (e) {
            image.src = "";
            modal.classList.remove("hidden");
            image.src = e.target.result;
            image.onload = function () {

                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }

                cropper = new Cropper(image, {
                    aspectRatio: NaN,       
                    viewMode: 2,          
                    dragMode: "move",
                    autoCropArea: 0.9,

                    background: false,
                    responsive: true,

                    cropBoxMovable: true,
                    cropBoxResizable: true,

                    guides: true,
                    center: true,
                    highlight: false,

                    minContainerWidth: 400,
                    minContainerHeight: 500
                });
            };
        };
        reader.readAsDataURL(file);
    });

    cancelBtn.addEventListener("click", function () {
        modal.classList.add("hidden");
        input.value = "";
        fileName.textContent = "No File Choosen";
        image.src = "";
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
    });

    cropBtn.addEventListener("click", function () {
        if (!cropper) return;
        const canvas = cropper.getCroppedCanvas({
            fillColor: "#fff",
            imageSmoothingEnabled: true,
            imageSmoothingQuality: "high",
            maxWidth: 2000,
            maxHeight: 3000
        });

        canvas.toBlob(function (blob) {
            if (blob.size > 5 * 1024 * 1024) {
                alert("Cropped image exceeds 5MB. Please crop smaller area.");
                return;
            }
            const file = new File([blob], currentFile.name, {
                type: "image/png"
            });
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            input.files = dataTransfer.files;
            fileName.textContent = file.name;
            modal.classList.add("hidden");
            image.src = "";
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
        }, "image/png", 1);
    });
</script>