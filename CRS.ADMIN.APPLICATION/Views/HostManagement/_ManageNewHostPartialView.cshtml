    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ranges = document.querySelectorAll(".skill-range");

        ranges.forEach(function (range) {
            const updateRange = function () {
                const min = Number(range.min);
                const max = Number(range.max);
                const value = Number(range.value);
                const percent = ((value - min) / (max - min)) * 100;

                range.style.setProperty("--progress", percent + "%");

                const skillItem = range.closest(".skill-item");
                const valueText = skillItem.querySelector(".range-value strong");
                const dots = skillItem.querySelectorAll(".range-dots span");

                if (valueText) {
                    valueText.textContent = value;
                }

                dots.forEach(function (dot, index) {
                    dot.classList.toggle("active", index < value);
                });
            };

            range.addEventListener("input", updateRange);
            updateRange();
        });

        const hostLogoInput = document.getElementById("HostLogoFile");
        const hostLogoFileName = document.getElementById("host_logo_file_name");

        if (hostLogoInput && hostLogoFileName) {
            hostLogoInput.addEventListener("change", function () {
                if (hostLogoInput.files && hostLogoInput.files.length > 0) {
                    const file = hostLogoInput.files[0];
                    const maxSize = 5 * 1024 * 1024;

                    if (file.size > maxSize) {
                        alert("Maximum file size is 5 MB.");
                        hostLogoInput.value = "";
                        hostLogoFileName.textContent = "No File Choosen";
                        return;
                    }

                    hostLogoFileName.textContent = file.name;
                } else {
                    hostLogoFileName.textContent = "No File Choosen";
                }
            });
        }
    });
</script>