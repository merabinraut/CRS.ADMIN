@model CRS.ADMIN.APPLICATION.Models.HostManagement.ManageHostModel

@{
    var rankList = ViewBag.RankDDL as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var heightList = ViewBag.HeightDDL as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var zodiacList = ViewBag.ZodiacSignsDDL as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var birthPlaceList = ViewBag.BirthPlaceDDL as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var bloodGroupList = ViewBag.BloodGroupDDL as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();

    var selectedRank = ViewBag.RankDDLKey as string;
    var selectedHeight = ViewBag.HeightDDLKey as string;
    var selectedZodiac = ViewBag.ZodiacSignsDDLKey as string;
    var selectedBirthPlace = ViewBag.BirthPlaceDDLKey as string;
    var selectedBloodGroup = ViewBag.BloodGroupDDLKey as string;

    //DateTime date = (!string.IsNullOrEmpty(Model.DOB) && Model.DOB.Trim().ToUpper() != "YYYY-MM-DD")
    //    ? Convert.ToDateTime(Model.DOB)
    //    : DateTime.Now;
    DateTime date;

    if (!string.IsNullOrWhiteSpace(Model.DOB) &&
        Model.DOB.Trim().ToUpper() != "YYYY-MM-DD" &&
        DateTime.TryParse(Model.DOB, out date))
    {
        // date parsed successfully
    }
    else
    {
        date = DateTime.Now;
    }

    int splitYear = date.Year;
    int splitMonth = date.Month;
    int splitDay = date.Day;
}

<style>
    .profile-section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        font-size: 16px;
        font-weight: 700;
        color: #111827;
        text-transform: uppercase;
    }

        .profile-section-title::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #eeeeee;
        }

    .skill-range {
        width: 100%;
        height: 32px;
        appearance: none;
        background: transparent;
        cursor: pointer;
        position: relative;
        z-index: 2;
        margin: 0;
    }

        .skill-range::-webkit-slider-runnable-track {
            height: 2px;
            background: linear-gradient( to right, #d94f86 0%, #d94f86 var(--progress, 50%), #dddddd var(--progress, 50%), #dddddd 100% );
        }

        .skill-range::-webkit-slider-thumb {
            appearance: none;
            width: 20px;
            height: 20px;
            background: #d94f86;
            border-radius: 50%;
            border: none;
            margin-top: -9px;
        }

        .skill-range::-moz-range-track {
            height: 2px;
            background: #dddddd;
        }

        .skill-range::-moz-range-progress {
            height: 2px;
            background: #d94f86;
        }

        .skill-range::-moz-range-thumb {
            width: 20px;
            height: 20px;
            background: #d94f86;
            border-radius: 50%;
            border: none;
        }

    .range-dots {
        position: absolute;
        left: 0;
        right: 0;
        top: 7px;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        z-index: 1;
    }

        .range-dots span {
            width: 16px;
            height: 16px;
            background: #dddddd;
            border-radius: 999px;
        }

            .range-dots span.active {
                background: #d94f86;
            }
</style>

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />

<div id="add-new-host"
