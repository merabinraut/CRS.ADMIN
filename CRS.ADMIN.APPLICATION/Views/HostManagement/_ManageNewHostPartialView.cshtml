                                <option value="">YYYY</option>

                                @{
                                    DateTime currentDate = DateTime.Now;
                                    int currentYear = currentDate.Year;
                                    int startYear = currentYear - 200;

                                        for (int year = currentYear; year >= startYear; year--)
                                        {
                                            if ((!string.IsNullOrEmpty(Model.DOB) && Model.DOB.Trim().ToUpper() != "YYYY-MM-DD") && splitYear == year)
                                            {
                                                <option value="@year" selected>@year</option>
                                            }
                                            else
                                            {
                                                <option value="@year">@year</option>
                                            }
                                        }
                                }
                            </select>

                            <select class="select-common block w-[100px]" name="BirthMonthKey">
                                <option value="">MM</option>

                                @for (int month = 1; month <= 12; month++)
                                {
                                    if ((!string.IsNullOrEmpty(Model.DOB) && Model.DOB.Trim().ToUpper() != "YYYY-MM-DD") && splitMonth == month)
                                    {
