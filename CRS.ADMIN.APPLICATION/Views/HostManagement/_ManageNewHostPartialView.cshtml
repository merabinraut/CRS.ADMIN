<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ranges = document.querySelectorAll(".skill-range");

        ranges.forEach(function (range) {
            const updateRange = function () {
                const min = Number(range.min);
                const max = Number(range.max);
                const value = Number(range.value);
                const percent = ((value - min) / (max - min)) * 100;

                range.style.setProperty("--progress", percent + "%");

                const skillItem = range.closest(".skill-item");
                const valueText = skillItem.querySelector(".range-value strong");
                const dots = skillItem.querySelectorAll(".range-dots span");
                const hiddenInput = skillItem.querySelector(".score-hidden");


                if (valueText) {
                    valueText.textContent = value;
                    hiddenInput.value = value;
                }

                dots.forEach(function (dot, index) {
                    dot.classList.toggle("active", index < value);
                });
            };

            range.addEventListener("input", updateRange);
            updateRange();
        });
    });
</script>



<script>
    (function () {
        const input = document.getElementById("file_input_business_certificate");
        const fileName = document.getElementById("file_name_bussiness_certificate");
        const modal = document.getElementById("cropModal");
        const cropBtn = document.getElementById("cropImageButton");
        const cancelBtn = document.getElementById("cancelCropButton");
        const imageToCrop = document.getElementById("imageToCrop");
        const cropImageWrapper = document.getElementById("cropImageWrapper");
        const preview = document.getElementById("croppedPreview");
        const form = input ? input.closest("form") : null;

        if (!input || !modal || !cropBtn || !cancelBtn || !imageToCrop || !cropImageWrapper || !preview) {
            return;
        }

        if (input.dataset.cropperInitialized === "true") {
            return;
        }

        input.dataset.cropperInitialized = "true";

        const maxFileSize = 5 * 1024 * 1024;

        const noFileChosenText = @Html.Raw(JsonSerializer.Serialize(CRS.ADMIN.APPLICATION.Resources.Resource.No_File_Choosen));
        const originalPreviewUrl = preview.getAttribute("src") || "";
        const originalFileName = fileName ? fileName.textContent : noFileChosenText;

        let cropper = null;
        let currentFile = null;
        let croppedFile = null;
        let previewObjectUrl = null;

        function destroyCropper() {
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            const oldCropperContainers = cropImageWrapper.querySelectorAll(".cropper-container");
            oldCropperContainers.forEach(function (container) {
                container.remove();
            });

            imageToCrop.className = "max-w-full block";
            imageToCrop.style.cssText = "";
        }

        function clearCropImage() {
            imageToCrop.onload = null;
            imageToCrop.onerror = null;
            imageToCrop.removeAttribute("src");
        }

        function closeModal() {
            modal.classList.add("hidden");
            destroyCropper();
            clearCropImage();
        }

        function openModal() {
            modal.classList.remove("hidden");
        }

        function resetFileInput() {
            input.value = "";
            currentFile = null;
        }

        function setInputFile(file) {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            input.files = dataTransfer.files;
        }

        function setPreview(src, isObjectUrl) {
            if (previewObjectUrl) {
                URL.revokeObjectURL(previewObjectUrl);
                previewObjectUrl = null;
            }

            if (!src) {
                preview.removeAttribute("src");
                preview.classList.add("hidden");
                return;
            }

            preview.src = src;
            preview.classList.remove("hidden");

            if (isObjectUrl) {
                previewObjectUrl = src;
            }
        }

        input.addEventListener("change", function () {
            if (!input.files || !input.files[0]) {
                return;
            }

            const file = input.files[0];

            if (!file.type.startsWith("image/")) {
                alert("Please select a valid image file.");
                resetFileInput();
                return;
            }

            if (file.size > maxFileSize) {
                alert("File must be less than 5 MB.");
                resetFileInput();
                return;
            }

            currentFile = file;
            croppedFile = null;

            if (fileName) {
                fileName.textContent = file.name;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                destroyCropper();
                clearCropImage();

                imageToCrop.onload = function () {
                    destroyCropper();

                    cropper = new Cropper(imageToCrop, {
                        aspectRatio: NaN,
                        viewMode: 2,
                        dragMode: "move",
                        autoCropArea: 0.9,
                        background: false,
                        responsive: true,
                        cropBoxMovable: true,
                        cropBoxResizable: true,
                        guides: true,
                        center: true,
                        highlight: false,
                        minContainerWidth: 400,
                        minContainerHeight: 500
                    });
                };

                imageToCrop.src = e.target.result;
                openModal();
            };

            reader.readAsDataURL(file);
        });

        cancelBtn.addEventListener("click", function (e) {
            e.preventDefault();

            closeModal();

            if (!croppedFile) {
                resetFileInput();

                if (fileName) {
                    fileName.textContent = originalFileName || noFileChosenText;
                }

                if (originalPreviewUrl) {
                    setPreview(originalPreviewUrl, false);
                } else {
                    setPreview("", false);
                }
            }
        });

        cropBtn.addEventListener("click", function (e) {
            e.preventDefault();

            if (!cropper || !currentFile) {
                return;
            }

            const canvas = cropper.getCroppedCanvas({
                fillColor: "#fff",
                imageSmoothingEnabled: true,
                imageSmoothingQuality: "high",
                maxWidth: 2000,
                maxHeight: 3000
            });

            if (!canvas) {
                return;
            }

            canvas.toBlob(function (blob) {
                if (!blob) {
                    return;
                }

                if (blob.size > maxFileSize) {
                    alert("Cropped image exceeds 5 MB.");
                    return;
                }

                const fileNameWithoutExtension = currentFile.name.replace(/\.[^/.]+$/, "");
                const newFileName = fileNameWithoutExtension + ".png";

                croppedFile = new File([blob], newFileName, {
                    type: "image/png"
                });

                setInputFile(croppedFile);

                const previewUrl = URL.createObjectURL(croppedFile);
                setPreview(previewUrl, true);

                if (fileName) {
                    fileName.textContent = croppedFile.name;
                }

                closeModal();
            }, "image/png");
        });

        if (form) {
            form.addEventListener("submit", function () {
                if (croppedFile) {
                    setInputFile(croppedFile);
                }
            });
        }
    })();
</script>