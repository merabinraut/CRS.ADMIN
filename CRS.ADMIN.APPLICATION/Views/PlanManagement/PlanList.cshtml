            if (PopUpRenderValue != null && PopUpRenderValue != "" && PopUpRenderValue == "Manage") {
                var element = document.getElementById('add-new-host-club');
                element.classList.remove('translate-x-full');
                }
            else if (PopUpClubManageValue == "ManageClubPlan") {
                element1 = document.getElementById('add-manage-club-own-plan');
                element1.classList.remove('translate-x-full');
           /* if (PopUpClubManageValue == "ManageClubPlan")*/
            }
                let tabValue = "@ViewBag.TabValue" ?? "";
                if (tabValue === "02") {
                    const link1 = document.getElementById('tab1Link');
                    const link2 = document.getElementById('tab2Link');
                    link1.style.color = '';
                    link1.style.borderBottom = '';
                    link2.style.color = '#D75A8B';
                    link2.style.borderBottom = '#D75A8B 2px solid';
                    document.getElementById('request1').style.display = 'block';
                    document.getElementById('all').style.display = 'none';

                }
                else {
                    const link1 = document.getElementById('tab1Link');
                    const link2 = document.getElementById('tab2Link');
                    link1.style.color = '#D75A8B';
                    link1.style.borderBottom = '#D75A8B 2px solid';
                    link2.style.color = '';
                    link2.style.borderBottom = '';
                    document.getElementById('request1').style.display = 'none';
                    document.getElementById('all').style.display = 'block';

                }
        });
        document.getElementById('CloseId').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });
        document.getElementById('CancelId').addEventListener('click',
            function (event) {
                event.preventDefault();
                window.location.reload();
            });
            function editPlanDetail(id) {
            window.location.href = '/PlanManagement/ManagePlan?planId=' + id;
            }

        function deletePlan(id) {
            $.ajax({
                type: 'POST',
                async: true,
                url: "/PlanManagement/EnableDisablePlans?id=" + id,
                dataType: 'json',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                },
                success: function () {
                    window.location.reload();
                },
                error: function (ex) {

                }
            });
        }
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
                const page_size = @ViewBag.PageSize;
                const total_data = @ViewBag.TotalData;
                const start_index_val = @ViewBag.StartIndex;
                let URL = "/PlanManagement/PlanList";
                let search_filter = $('#default-search-plan_list').val();
                URL = addQueryParam(URL, 'SearchFilter', search_filter);
                LoadPagination(page_size, total_data, start_index_val, URL);
            });
    </script>

    <script>
        function toggleInputField() {
            var inputField = document.getElementById('txtInputField');
            if (document.getElementById('chkShowInput').checked) {
                inputField.style.display = 'block';
            } else {
                inputField.style.display = 'none';
            }
        }

    </script>
    <script>

            document.getElementById('tab1Link').style.color = '#D75A8B';
            document.getElementById('tab1Link').style.borderBottom = '#D75A8B 2px solid';

            function changeTabV1(selectedTabId, selectedLinkId) {
                const tabLinks = document.querySelectorAll('.styleCss');
                const tabContents = document.querySelectorAll('.pane');

                // Remove active styles from links, add to the one clicked
                tabLinks.forEach(link => {
                    if (link.id === selectedLinkId) {
                        link.classList.add('active');
                    } else {
                        link.classList.remove('active');
                    }
                });

                // Hide all tab contents, show selected
                tabContents.forEach(content => {
                    if (content.id === selectedTabId) {
                        content.style.display = 'block';
                    } else {
                        content.style.display = 'none';
                    }
                });
                // Apply the visual style (color + border) for the selected link and reset others
                if (selectedLinkId === 'tab1Link') {
                    const link1 = document.getElementById('tab1Link');
                    const link2 = document.getElementById('tab2Link');
                    link1.style.color = '#D75A8B';
                    link1.style.borderBottom = '#D75A8B 2px solid';
                    link2.style.color = '';
                    link2.style.borderBottom = '';
                    let URL2 = "/PlanManagement/PlanList";
                    let search_filter2 = $('#default-search-plan_list').val();
                    URL = addQueryParam3(URL2, 'TabValue', '', 'SearchFilter', search_filter2);
                    window.location.href = URL
                }
                else if (selectedLinkId === 'tab2Link') {
                    const link1 = document.getElementById('tab1Link');
                    const link2 = document.getElementById('tab2Link');
                    link1.style.color = '';
                    link1.style.borderBottom = '';
                    link2.style.color = '#D75A8B';
                    link2.style.borderBottom = '#D75A8B 2px solid';
                    let URL2 = "/PlanManagement/PlanList";
                    let search_filter2 = $('#default-search-plan-request').val();
                    URL = addQueryParam3(URL2, 'TabValue', '02', 'SearchFilter', search_filter2);
                    window.location.href = URL
                }
            }
            function addQueryParam3(url, paramName, paramValue, paramName2, paramValue2) {
                if (paramValue != null && paramValue != "") {
                    url += url.includes('?') ? `&${paramName}=${paramValue}` : `?${paramName}=${paramValue}`;
                }
                if (paramValue2 != null && paramValue2 != "") {
                    url += url.includes('?') ? `&${paramName2}=${paramValue2}` : `?${paramName2}=${paramValue2}`;
                }

                return url;
            }



            function openApproveRequestModal(sno, type, planId)
            {
                    const modalTarget = document.querySelector("[data-modal-target='approve-confirmation-plan-request']");
                    const confirmationMessageElement = document.getElementById("confirmationRequestMessage");
                    const contentApprove = "@Html.Raw(CRS.ADMIN.APPLICATION.Resources.Resource.PlanRequestConfirmationMessage)";
                confirmationMessageElement.textContent = contentApprove;

                    const modal = document.getElementById("approve-confirmation-plan-request");
                     modal.classList.remove("hidden");
                    $('#approve_ids1').attr('data-vals1', sno);
                    $('#approve_ids1').attr('data-vals2', type);
                    $('#approve_ids1').attr('data-vals3', planId);
                    modal.setAttribute("aria-hidden", "false");
            }

    </script>
