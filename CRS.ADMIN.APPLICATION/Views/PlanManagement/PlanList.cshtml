@model CRS.ADMIN.APPLICATION.Models.PlanManagement.PlansManagementModel
@{
    ViewBag.Title = "Plan List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var _PlanModel = Model.PlanMgmt as CRS.ADMIN.APPLICATION.Models.PlanManagement.PlanManagementModel;
    var _ClubPlanModel = Model.clubPlanManageModel as CRS.ADMIN.APPLICATION.Models.PlanManagement.PlanRequesResponseListModel;
}

<div class="px-8 py-4">
    @Html.AntiForgeryToken()
    <div class="flex flex-col  gap-6">
        <a href="~/Views/PlanManagement/PlanList.cshtml">~/Views/PlanManagement/PlanList.cshtml</a>

        <div class="flex justify-between items-center">
            <div>
                <div class="heading-title">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Plan_Management
                </div>
                <div class="span-title-light-gray">
                    @CRS.ADMIN.APPLICATION.Resources.Resource.Plan_Management_Supporting_Text
                </div>
            </div>

        </div>

        <div id="tab1" class="tab-content-plane ">
            <div class="flex flex-col gap-8">
                <div id="tab1" class="tab-content">
                    <div class="flex gap-4 mb-8 border-b ">

                        <div id="tab1Link" class="styleCss px-1 pb-4 cursor-pointer active" onclick="changeTabV1('all', 'tab1Link')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Plan_Setup
                        </div>

                        <div id="tab2Link" class="styleCss px-1 pb-4 cursor-pointer" onclick="changeTabV1('request1','tab2Link')">
                            @CRS.ADMIN.APPLICATION.Resources.Resource.Plan_Request
                        </div>
                    </div>
                    <div class="flex justify-between pb-[24px]">


                    </div>

                    <div class="pane active table-tab" id="all">
                        @if (!string.IsNullOrEmpty(Convert.ToString(Model.PlanManagementModel)))
                        {
                            @Html.Partial("_PlanListPartialView", Model)
                        }
                    </div>
                    <div class="pane" id="request1" style="display: none;">
                        @Html.Partial("_OwnPlanByClubPartialView", Model.ClubPlanResponseModel)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="approve-confirmation-plan-request" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full
     p-4 overflow-x-hidden overflow-y-auto
     md:inset-0 h-[calc(100%-1rem)] max-h-full " style="align-items: flex-start;">
    <div class="relative max-w-2xl max-h-full w-[412px] px-4 pt-[40px] pb-[46px] mt-24">
        <!-- Modal content -->
        <div class="relative bg-white rounded-lg shadow">
            <!-- Modal header -->
            <button type="button"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ml-auto inline-flex justify-center items-center absolute top-[24px] right-[20px] "
                    data-modal-hide="approve-confirmation-plan-request">
